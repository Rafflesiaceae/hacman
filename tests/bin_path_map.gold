name: multi-call
sandboxed: true
sandbox-write-dir: /home/hacman-test/.cache/hacman/cmd-<identity-hash>.work
command: rustup update stable
workdir: /home/hacman-test/.cache/hacman/cmd-<identity-hash>.work
run: /bin/sh -c <command>, in workdir
record-when: the command exits 0
schedule: 1w
check-when: 604800 seconds after the last run
cache-identity: siml:<hash> hacman:<version>
cache-file: /home/hacman-test/.cache/hacman/cmd-<identity-hash>
bin-name: cargo (default)
bin-path: /home/hacman-test/.cargo/bin/cargo
exec: bin-path, with every argument that followed FILE
