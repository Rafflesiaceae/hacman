name: cached-tool
sandboxed: true
sandbox-write-dir: /home/hacman-test/.cache/hacman/url-<identity-hash>.work
url: https://example.com/tool
check: etag
request: HEAD https://example.com/tool
compare: the ETag header, or Last-Modified when absent
schedule: 1d
check-when: 86400 seconds after the last run
cache-identity: siml:<hash> hacman:<version>
cache-file: /home/hacman-test/.cache/hacman/url-<identity-hash>
bin-path: /home/hacman-test/.cache/hacman/url-<identity-hash>.work/bin/tool
exec: bin-path, with every argument that followed FILE
install-shell: /bin/sh -e <script>
install-env: [HACMAN_NAME,HACMAN_URL,HACMAN_CHECK,HACMAN_VERSION,HACMAN_PREVIOUS]
install: |
  install -Dm755 downloaded bin/tool
