name: https://example.com/artifact.tar.gz
sandboxed: true
sandbox-write-dir: /home/hacman-test/.cache/hacman/url-<identity-hash>.work
url: https://example.com/artifact.tar.gz
check: etag
request: HEAD https://example.com/artifact.tar.gz
compare: the ETag header, or Last-Modified when absent
schedule: 1d
check-when: 86400 seconds after the last run
cache-identity: siml:<hash> hacman:<version>
cache-file: /home/hacman-test/.cache/hacman/url-<identity-hash>
install: (none - a change would only be reported)
