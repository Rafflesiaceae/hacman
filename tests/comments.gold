name: commented
url: https://example.com/x
check: etag
request: HEAD https://example.com/x
compare: the ETag header, or Last-Modified when absent
schedule: 30d
check-when: 2592000 seconds after the last run
cache-identity: url etag https://example.com/x
cache-file: /home/hacman-test/.cache/hacman/url-4089f6dcfcb6f3fc
install: (none - a change would only be reported)
