#!/usr/bin/env hacman
# A complete Go project carried by one .siml file. Run it directly with hacman.
# Repairs mixed Markdown/rST, then canonicalizes it through Pandoc.
name: rst-fixup-chatgpt
command: mkdir -p build .go-tmp/sys .go-tmp/work .go-cache .go-path && export TMPDIR="$PWD/.go-tmp/sys" GOTMPDIR="$PWD/.go-tmp/work" GOCACHE="$PWD/.go-cache" GOPATH="$PWD/.go-path" GOWORK=off GOENV=off GOTOOLCHAIN=auto && unset GOFLAGS && command -v pandoc >/dev/null && go test ./... && go build -trimpath -ldflags='-s -w' -o build/rst-fixup-chatgpt ./cmd/rst-fixup-chatgpt
bin-path: build/rst-fixup-chatgpt
files:
  go.mod: |
    module example.com/rst-fixup-chatgpt

    go 1.26.4
  cmd/rst-fixup-chatgpt/main.go: |
    package main

    import (
    	"bytes"
    	"flag"
    	"fmt"
    	"io"
    	"os"
    	"os/exec"
    	"path/filepath"
    	"strings"

    	"example.com/rst-fixup-chatgpt/internal/normalize"
    )

    func main() {
    	var (
    		outPath = flag.String("o", "", "write normalized rST to FILE instead of replacing the input")
    		stdout  = flag.Bool("stdout", false, "write to stdout instead of replacing a named input file")
    		inPlace = flag.Bool("w", false, "rewrite the input file in place (default for a named FILE; retained for compatibility)")
    		check   = flag.Bool("check", false, "exit 1 if the input would change after normalization")
    		verbose = flag.Bool("v", false, "print normalization statistics to stderr")
    	)
    	flag.Usage = func() {
    		fmt.Fprintf(flag.CommandLine.Output(), "usage: %s [options] [FILE|-]\n\n", filepath.Base(os.Args[0]))
    		fmt.Fprintln(flag.CommandLine.Output(), "Normalize Markdown accidentally mixed into reStructuredText, then re-render it through Pandoc.")
    		fmt.Fprintln(flag.CommandLine.Output(), "A named FILE is replaced atomically by default, but only after normalization and Pandoc rendering succeed.")
    		fmt.Fprintln(flag.CommandLine.Output(), "With no FILE, or FILE '-', input is read from stdin and output is written to stdout.")
    		fmt.Fprintln(flag.CommandLine.Output())
    		flag.PrintDefaults()
    	}
    	flag.Parse()

    	if flag.NArg() > 1 {
    		flag.Usage()
    		os.Exit(2)
    	}
    	if *outPath != "" && *stdout {
    		fatal("-o and -stdout are mutually exclusive")
    	}
    	if *inPlace && (*outPath != "" || *stdout) {
    		fatal("-w cannot be combined with -o or -stdout")
    	}

    	inputName := "-"
    	if flag.NArg() == 1 {
    		inputName = flag.Arg(0)
    	}
    	if *inPlace && inputName == "-" {
    		fatal("-w requires an input file")
    	}

    	in, err := readInput(inputName)
    	if err != nil {
    		fatal("read input: %v", err)
    	}

    	// Stage 1: repair Markdown syntax leaked into an otherwise-rST document.
    	pre, stats := normalize.Normalize(string(in))

    	// Stage 2: re-render the repaired rST through Pandoc, equivalent to:
    	// pandoc -f rst -t rst --wrap=auto --columns=120 inp.rst
    	// Nothing is written to the original file unless Pandoc succeeds.
    	out, err := runPandoc([]byte(pre))
    	if err != nil {
    		fatal("pandoc rST round-trip: %v", err)
    	}

    	if *verbose {
    		fmt.Fprintf(os.Stderr,
    			"headings=%d fenced-code=%d repaired-fences=%d inline-code=%d links=%d images=%d tables=%d quotes=%d lists=%d references=%d changed=%t\n",
    			stats.Headings, stats.FencedCode, stats.RepairedFences, stats.InlineCode,
    			stats.Links, stats.Images, stats.Tables, stats.Quotes, stats.Lists, stats.References,
    			!bytes.Equal(out, in),
    		)
    		for _, warning := range stats.Warnings {
    			fmt.Fprintf(os.Stderr, "warning: %s\n", warning)
    		}
    	}

    	changed := !bytes.Equal(out, in)
    	if *check {
    		if changed {
    			os.Exit(1)
    		}
    		return
    	}

    	switch {
    	case *outPath != "":
    		if err := writeOutput(*outPath, out); err != nil {
    			fatal("write %s: %v", *outPath, err)
    		}
    	case *stdout || inputName == "-":
    		if _, err := os.Stdout.Write(out); err != nil {
    			fatal("write stdout: %v", err)
    		}
    	default:
    		// Named files are in-place by default. atomicWrite creates and fully
    		// flushes a sibling temporary file before rename(2), so a Pandoc,
    		// write or fsync failure never truncates the original file.
    		if changed {
    			if err := atomicWrite(inputName, out); err != nil {
    				fatal("rewrite %s: %v", inputName, err)
    			}
    		}
    	}
    }

    func readInput(name string) ([]byte, error) {
    	if name == "-" {
    		return io.ReadAll(os.Stdin)
    	}
    	return os.ReadFile(name)
    }

    func runPandoc(in []byte) ([]byte, error) {
    	f, err := os.CreateTemp("", "rst-fixup-chatgpt-*.rst")
    	if err != nil {
    		return nil, fmt.Errorf("create temporary input: %w", err)
    	}
    	name := f.Name()
    	defer os.Remove(name)

    	if _, err := f.Write(in); err != nil {
    		_ = f.Close()
    		return nil, fmt.Errorf("write temporary input: %w", err)
    	}
    	if err := f.Close(); err != nil {
    		return nil, fmt.Errorf("close temporary input: %w", err)
    	}

    	cmd := exec.Command("pandoc", "-f", "rst", "-t", "rst", "--wrap=auto", "--columns=120", name)
    	var stdout, stderr bytes.Buffer
    	cmd.Stdout = &stdout
    	cmd.Stderr = &stderr
    	if err := cmd.Run(); err != nil {
    		msg := strings.TrimSpace(stderr.String())
    		if msg != "" {
    			return nil, fmt.Errorf("%w: %s", err, msg)
    		}
    		return nil, err
    	}
    	return stdout.Bytes(), nil
    }

    func writeOutput(name string, data []byte) error {
    	if name == "-" {
    		_, err := os.Stdout.Write(data)
    		return err
    	}
    	return os.WriteFile(name, data, 0o644)
    }

    func atomicWrite(name string, data []byte) error {
    	st, err := os.Stat(name)
    	if err != nil {
    		return err
    	}
    	dir := filepath.Dir(name)
    	f, err := os.CreateTemp(dir, ".rst-fixup-chatgpt-*")
    	if err != nil {
    		return err
    	}
    	tmp := f.Name()
    	committed := false
    	defer func() {
    		_ = f.Close()
    		if !committed {
    			_ = os.Remove(tmp)
    		}
    	}()

    	if err := f.Chmod(st.Mode().Perm()); err != nil {
    		return err
    	}
    	if _, err := f.Write(data); err != nil {
    		return err
    	}
    	if err := f.Sync(); err != nil {
    		return err
    	}
    	if err := f.Close(); err != nil {
    		return err
    	}
    	if err := os.Rename(tmp, name); err != nil {
    		return err
    	}
    	committed = true
    	return nil
    }

    func fatal(format string, args ...any) {
    	fmt.Fprintf(os.Stderr, "rst-fixup-chatgpt: "+format+"\n", args...)
    	os.Exit(2)
    }
  internal/normalize/normalize.go: |
    package normalize

    import (
    	"fmt"
    	"regexp"
    	"strings"
    	"unicode"
    	"unicode/utf8"
    )

    type Stats struct {
    	Headings       int
    	FencedCode     int
    	RepairedFences int
    	InlineCode     int
    	Links          int
    	Images         int
    	Tables         int
    	Quotes         int
    	Lists          int
    	References     int
    	Warnings       []string
    }

    type outLine struct {
    	text string
    	raw  bool
    }

    var (
    	atxHeadingRE   = regexp.MustCompile(`^\s{0,3}(#{1,6})[ \t]+(.+?)[ \t]*#*[ \t]*$`)
    	fenceRE        = regexp.MustCompile(`^\s*(` + "`{3,}|~{3,}" + `)(.*)$`)
    	bulletRE       = regexp.MustCompile(`^(\s*)[-+*]\s+(.*)$`)
    	orderedParenRE = regexp.MustCompile(`^(\s*)([0-9]+|[A-Za-z])\)\s+(.*)$`)
    	refDefRE       = regexp.MustCompile(`^\s*\[([^\]^][^\]]*)\]:\s*(\S+)(?:\s+.*)?$`)
    	footnoteDefRE  = regexp.MustCompile(`^\s*\[\^([0-9]+)\]:\s*(.*)$`)
    	blockImageRE   = regexp.MustCompile(`^\s*!\[([^\]]*)\]\(([^\s)]+)(?:\s+"[^"]*")?\)\s*$`)
    	mdImageRE      = regexp.MustCompile(`!\[([^\]]*)\]\(([^\s)]+)(?:\s+"[^"]*")?\)`)
    	mdLinkRE       = regexp.MustCompile(`\[([^\]]+)\]\(([^\s)]+)(?:\s+"[^"]*")?\)`)
    	mdRefLinkRE    = regexp.MustCompile(`\[([^\]]+)\]\[([^\]]+)\]`)
    	mdFootnoteRE   = regexp.MustCompile(`\[\^([0-9]+)\]`)
    	autoLinkRE     = regexp.MustCompile(`<((?:https?|mailto):[^>]+)>`)
    	strikeRE       = regexp.MustCompile(`~~([^~\n]+)~~`)
    )

    var headingChars = map[int]rune{
    	1: '=',
    	2: '-',
    	3: '~',
    	4: '^',
    	5: '"',
    	6: '\'',
    }

    var adornLevel = map[rune]int{
    	'=':  1,
    	'-':  2,
    	'~':  3,
    	'^':  4,
    	'"':  5,
    	'\'': 6,
    }

    func Normalize(input string) (string, Stats) {
    	var stats Stats
    	input = strings.TrimPrefix(input, "\ufeff")
    	input = strings.ReplaceAll(input, "\r\n", "\n")
    	input = strings.ReplaceAll(input, "\r", "\n")
    	lines := strings.Split(input, "\n")

    	leakedHeading, removeFence := detectLeakedHeadingFences(lines)
    	for i := range lines {
    		if removeFence[i] {
    			continue
    		}
    		if isRedundantRSTLiteralFenceClose(lines, i) {
    			removeFence[i] = true
    		}
    	}
    	stats.RepairedFences = len(removeFence)

    	out := make([]outLine, 0, len(lines)+32)
    	for i := 0; i < len(lines); {
    		if removeFence[i] {
    			i++
    			continue
    		}

    		if level, ok := leakedHeading[i]; ok {
    			emitHeading(&out, strings.TrimSpace(lines[i]), level)
    			stats.Headings++
    			i++
    			continue
    		}

    		if i+2 < len(lines) && isAdornmentLine(lines[i]) && !removeFence[i] &&
    			strings.TrimSpace(lines[i+1]) != "" && sameAdornment(lines[i], lines[i+2]) {
    			ch, _ := adornment(lines[i])
    			level := levelForAdornment(ch)
    			emitHeading(&out, strings.TrimSpace(lines[i+1]), level)
    			stats.Headings++
    			i += 3
    			continue
    		}

    		if m := atxHeadingRE.FindStringSubmatch(lines[i]); m != nil {
    			level := len(m[1])
    			title := strings.TrimSpace(m[2])
    			emitHeading(&out, normalizeInline(title, &stats), level)
    			stats.Headings++
    			i++
    			continue
    		}

    		if i+1 < len(lines) && strings.TrimSpace(lines[i]) != "" && isAdornmentLine(lines[i+1]) {
    			ch, _ := adornment(lines[i+1])
    			if looksLikeHeadingText(lines[i]) {
    				emitHeading(&out, normalizeInline(strings.TrimSpace(lines[i]), &stats), levelForAdornment(ch))
    				stats.Headings++
    				i += 2
    				continue
    			}
    		}

    		if opener, info, ok := parseFence(lines[i]); ok {
    			close := findFenceClose(lines, i+1, opener, removeFence)
    			if close < 0 {
    				if info == "" && onlyBlankAfter(lines, i+1) {
    					stats.Warnings = append(stats.Warnings, fmt.Sprintf("removed unmatched empty fence at line %d", i+1))
    					i++
    					continue
    				}
    				stats.Warnings = append(stats.Warnings, fmt.Sprintf("unterminated fenced block starting at line %d; treated through EOF as code", i+1))
    				close = len(lines)
    			}
    			code := lines[i+1 : close]
    			emitFencedCode(&out, code, normalizeFenceLanguage(info))
    			stats.FencedCode++
    			if close == len(lines) {
    				i = close
    			} else {
    				i = close + 1
    			}
    			continue
    		}

    		if isLiteralIntroducer(lines[i]) {
    			end, ok := literalBlockEnd(lines, i)
    			if ok {
    				appendNormal(&out, rtrim(lines[i]))
    				for j := i + 1; j < end; j++ {
    					appendRaw(&out, lines[j])
    				}
    				i = end
    				continue
    			}
    		}

    		if isDirective(lines[i]) {
    			end := directiveBlockEnd(lines, i)
    			appendNormal(&out, rtrim(lines[i]))
    			for j := i + 1; j < end; j++ {
    				appendRaw(&out, lines[j])
    			}
    			i = end
    			continue
    		}

    		if i+1 < len(lines) && looksPipeRow(lines[i]) && looksTableDelimiter(lines[i+1]) {
    			end, grid := convertPipeTable(lines, i, &stats)
    			for _, l := range grid {
    				appendNormal(&out, l)
    			}
    			stats.Tables++
    			i = end
    			continue
    		}

    		if m := blockImageRE.FindStringSubmatch(lines[i]); m != nil {
    			ensureBlankBefore(&out)
    			appendNormal(&out, ".. image:: "+m[2])
    			if strings.TrimSpace(m[1]) != "" {
    				appendNormal(&out, "   :alt: "+strings.TrimSpace(m[1]))
    			}
    			appendNormal(&out, "")
    			stats.Images++
    			i++
    			continue
    		}

    		if m := footnoteDefRE.FindStringSubmatch(lines[i]); m != nil {
    			ensureBlankBefore(&out)
    			appendNormal(&out, fmt.Sprintf(".. [%s] %s", m[1], normalizeInline(m[2], &stats)))
    			stats.References++
    			i++
    			continue
    		}

    		if m := refDefRE.FindStringSubmatch(lines[i]); m != nil {
    			ensureBlankBefore(&out)
    			appendNormal(&out, fmt.Sprintf(".. _%s: %s", strings.TrimSpace(m[1]), m[2]))
    			stats.References++
    			i++
    			continue
    		}

    		if strings.HasPrefix(strings.TrimLeft(lines[i], " \t"), ">") {
    			for i < len(lines) && strings.HasPrefix(strings.TrimLeft(lines[i], " \t"), ">") {
    				appendNormal(&out, normalizeQuoteLine(lines[i], &stats))
    				stats.Quotes++
    				i++
    			}
    			continue
    		}

    		if isThematicBreak(lines[i]) {
    			ensureBlankBefore(&out)
    			appendNormal(&out, "----")
    			appendNormal(&out, "")
    			i++
    			continue
    		}

    		if m := bulletRE.FindStringSubmatch(lines[i]); m != nil {
    			appendNormal(&out, m[1]+"* "+normalizeInline(m[2], &stats))
    			stats.Lists++
    			i++
    			continue
    		}
    		if m := orderedParenRE.FindStringSubmatch(lines[i]); m != nil {
    			appendNormal(&out, m[1]+m[2]+". "+normalizeInline(m[3], &stats))
    			stats.Lists++
    			i++
    			continue
    		}

    		appendNormal(&out, normalizeInline(rtrim(lines[i]), &stats))
    		i++
    	}

    	out = compactNormalBlankLines(out)
    	for len(out) > 0 && strings.TrimSpace(out[len(out)-1].text) == "" {
    		out = out[:len(out)-1]
    	}

    	var b strings.Builder
    	for _, l := range out {
    		b.WriteString(l.text)
    		b.WriteByte('\n')
    	}
    	return b.String(), stats
    }

    func detectLeakedHeadingFences(lines []string) (map[int]int, map[int]bool) {
    	headings := make(map[int]int)
    	remove := make(map[int]bool)
    	for i, line := range lines {
    		opener, info, ok := parseFence(line)
    		if !ok || info != "" || opener[0] != '`' {
    			continue
    		}
    		p := prevNonBlank(lines, i-1)
    		n := nextNonBlank(lines, i+1)
    		if p < 0 || n < 0 || i-p > 2 {
    			continue
    		}
    		if !looksLikeLeakedHeadingTitle(lines[p]) || looksCodeLike(lines[n]) {
    			continue
    		}
    		if strings.TrimSpace(lines[p]) == "::" || strings.HasSuffix(strings.TrimSpace(lines[p]), "::") {
    			continue
    		}
    		headings[p] = 3
    		remove[i] = true
    	}
    	return headings, remove
    }

    func isRedundantRSTLiteralFenceClose(lines []string, i int) bool {
    	_, info, ok := parseFence(lines[i])
    	if !ok || info != "" {
    		return false
    	}
    	j := i - 1
    	for j >= 0 && strings.TrimSpace(lines[j]) == "" {
    		j--
    	}
    	if j < 0 || !isIndented(lines[j]) {
    		return false
    	}
    	for ; j >= 0; j-- {
    		if _, _, fence := parseFence(lines[j]); fence {
    			return false
    		}
    		if strings.TrimSpace(lines[j]) == "" || isIndented(lines[j]) {
    			continue
    		}
    		return strings.TrimSpace(lines[j]) == "::"
    	}
    	return false
    }

    func looksLikeLeakedHeadingTitle(s string) bool {
    	s = strings.TrimSpace(s)
    	if s == "" || len(s) > 80 || strings.ContainsAny(s, "`|{}[]=<>\\") {
    		return false
    	}
    	if strings.ContainsAny(s[len(s)-1:], ":;,.!?") {
    		return false
    	}
    	if strings.HasPrefix(s, ".. ") || strings.HasPrefix(s, "#") || strings.HasPrefix(s, "*") || strings.HasPrefix(s, "-") || strings.HasPrefix(s, "+") {
    		return false
    	}
    	words := strings.Fields(s)
    	if len(words) == 0 || len(words) > 12 {
    		return false
    	}
    	stops := map[string]bool{"a": true, "an": true, "and": true, "as": true, "at": true, "by": true, "for": true, "from": true, "in": true, "of": true, "on": true, "or": true, "the": true, "to": true, "vs": true, "with": true}
    	significant := 0
    	for _, w := range words {
    		w = strings.Trim(w, "()[]")
    		if w == "" {
    			continue
    		}
    		lw := strings.ToLower(w)
    		if stops[lw] {
    			continue
    		}
    		r, _ := utf8.DecodeRuneInString(w)
    		if !(unicode.IsUpper(r) || unicode.IsDigit(r)) {
    			return false
    		}
    		significant++
    	}
    	return significant > 0
    }

    func looksCodeLike(s string) bool {
    	t := strings.TrimSpace(s)
    	if t == "" {
    		return false
    	}
    	if bulletRE.MatchString(t) || orderedParenRE.MatchString(t) {
    		return false
    	}
    	if strings.HasPrefix(t, ".. ") {
    		return false
    	}
    	if strings.HasSuffix(t, ":") && len(strings.Fields(t)) <= 8 {
    		return false
    	}
    	if strings.ContainsAny(t, "{}();=$") || strings.HasPrefix(t, "#include") || strings.HasPrefix(t, "./") || strings.HasPrefix(t, "CC=") {
    		return true
    	}
    	r, _ := utf8.DecodeRuneInString(t)
    	if unicode.IsLower(r) || strings.HasPrefix(t, "-") {
    		return true
    	}
    	return false
    }

    func parseFence(line string) (opener, info string, ok bool) {
    	m := fenceRE.FindStringSubmatch(line)
    	if m == nil {
    		return "", "", false
    	}
    	return m[1], strings.TrimSpace(m[2]), true
    }

    func findFenceClose(lines []string, start int, opener string, remove map[int]bool) int {
    	ch := opener[0]
    	min := len(opener)
    	for i := start; i < len(lines); i++ {
    		if remove[i] {
    			continue
    		}
    		run, info, ok := parseFence(lines[i])
    		if !ok || info != "" || run[0] != ch || len(run) < min {
    			continue
    		}
    		return i
    	}
    	return -1
    }

    func normalizeFenceLanguage(info string) string {
    	info = strings.TrimSpace(info)
    	if info == "" {
    		return ""
    	}
    	first := strings.Fields(info)[0]
    	if strings.HasPrefix(first, "{.") && strings.HasSuffix(first, "}") {
    		first = strings.TrimSuffix(strings.TrimPrefix(first, "{."), "}")
    	}
    	first = strings.TrimPrefix(first, ".")
    	switch strings.ToLower(first) {
    	case "sh", "shell":
    		return "bash"
    	case "py":
    		return "python"
    	case "golang":
    		return "go"
    	}
    	return first
    }

    func emitFencedCode(out *[]outLine, code []string, lang string) {
    	code = dedentCode(code)
    	prev := lastNonBlank(*out)
    	alreadyLiteral := prev >= 0 && (strings.TrimSpace((*out)[prev].text) == "::" || strings.HasSuffix(strings.TrimSpace((*out)[prev].text), "::"))
    	if !alreadyLiteral {
    		ensureBlankBefore(out)
    		if lang != "" {
    			appendNormal(out, ".. code-block:: "+lang)
    		} else {
    			appendNormal(out, "::")
    		}
    	}
    	appendNormal(out, "")
    	for _, line := range code {
    		if line == "" {
    			appendRaw(out, "")
    		} else {
    			appendRaw(out, "    "+line)
    		}
    	}
    	appendNormal(out, "")
    }

    func dedentCode(code []string) []string {
    	min := -1
    	for _, line := range code {
    		if strings.TrimSpace(line) == "" {
    			continue
    		}
    		n := 0
    		for n < len(line) && line[n] == ' ' {
    			n++
    		}
    		if min < 0 || n < min {
    			min = n
    		}
    	}
    	if min <= 0 {
    		return code
    	}
    	out := make([]string, len(code))
    	for i, line := range code {
    		if len(line) >= min {
    			out[i] = line[min:]
    		} else {
    			out[i] = line
    		}
    	}
    	return out
    }

    func emitHeading(out *[]outLine, title string, level int) {
    	if level < 1 {
    		level = 1
    	}
    	if level > 6 {
    		level = 6
    	}
    	ensureBlankBefore(out)
    	appendNormal(out, title)
    	n := utf8.RuneCountInString(title)
    	if n < 3 {
    		n = 3
    	}
    	appendNormal(out, strings.Repeat(string(headingChars[level]), n))
    	appendNormal(out, "")
    }

    func isAdornmentLine(s string) bool {
    	_, n := adornment(s)
    	return n >= 3
    }

    func adornment(s string) (rune, int) {
    	t := strings.TrimSpace(s)
    	if t == "" {
    		return 0, 0
    	}
    	var first rune
    	count := 0
    	for _, r := range t {
    		if count == 0 {
    			first = r
    			if !strings.ContainsRune("=-~^\"':+*.#_", r) {
    				return 0, 0
    			}
    		} else if r != first {
    			return 0, 0
    		}
    		count++
    	}
    	return first, count
    }

    func sameAdornment(a, b string) bool {
    	ca, na := adornment(a)
    	cb, nb := adornment(b)
    	return na >= 3 && nb >= 3 && ca == cb
    }

    func levelForAdornment(ch rune) int {
    	if n, ok := adornLevel[ch]; ok {
    		return n
    	}
    	return 3
    }

    func looksLikeHeadingText(s string) bool {
    	t := strings.TrimSpace(s)
    	if t == "" || len(t) > 160 || strings.HasPrefix(t, ".. ") {
    		return false
    	}
    	return !bulletRE.MatchString(t) && !orderedParenRE.MatchString(t)
    }

    func isLiteralIntroducer(line string) bool {
    	t := strings.TrimSpace(line)
    	return t == "::" || (strings.HasSuffix(t, "::") && !strings.HasPrefix(t, ".. "))
    }

    func literalBlockEnd(lines []string, i int) (int, bool) {
    	j := i + 1
    	if j >= len(lines) || strings.TrimSpace(lines[j]) != "" {
    		return i + 1, false
    	}
    	j++
    	if j >= len(lines) || !isIndented(lines[j]) {
    		return i + 1, false
    	}
    	seen := false
    	for j < len(lines) {
    		if strings.TrimSpace(lines[j]) == "" {
    			j++
    			continue
    		}
    		if !isIndented(lines[j]) {
    			break
    		}
    		seen = true
    		j++
    	}
    	return j, seen
    }

    func isDirective(line string) bool {
    	t := strings.TrimSpace(line)
    	return strings.HasPrefix(t, ".. ") && strings.Contains(t, "::")
    }

    func directiveBlockEnd(lines []string, i int) int {
    	j := i + 1
    	for j < len(lines) {
    		if strings.TrimSpace(lines[j]) == "" {
    			j++
    			continue
    		}
    		if !isIndented(lines[j]) {
    			break
    		}
    		j++
    	}
    	return j
    }

    func isIndented(s string) bool {
    	return strings.HasPrefix(s, " ") || strings.HasPrefix(s, "\t")
    }

    func looksPipeRow(s string) bool {
    	t := strings.TrimSpace(s)
    	return strings.Contains(t, "|") && !strings.HasPrefix(t, ".. ")
    }

    func looksTableDelimiter(s string) bool {
    	cells := splitPipeRow(s)
    	if len(cells) == 0 {
    		return false
    	}
    	for _, c := range cells {
    		c = strings.TrimSpace(c)
    		c = strings.TrimPrefix(c, ":")
    		c = strings.TrimSuffix(c, ":")
    		if len(c) < 3 || strings.Trim(c, "-") != "" {
    			return false
    		}
    	}
    	return true
    }

    func splitPipeRow(s string) []string {
    	t := strings.TrimSpace(s)
    	if strings.HasPrefix(t, "|") {
    		t = t[1:]
    	}
    	if strings.HasSuffix(t, "|") && !strings.HasSuffix(t, `\|`) {
    		t = t[:len(t)-1]
    	}
    	var cells []string
    	var b strings.Builder
    	escaped := false
    	codeTicks := 0
    	for i := 0; i < len(t); i++ {
    		c := t[i]
    		if escaped {
    			if c == '|' {
    				b.WriteByte('|')
    			} else {
    				b.WriteByte('\\')
    				b.WriteByte(c)
    			}
    			escaped = false
    			continue
    		}
    		if c == '\\' {
    			escaped = true
    			continue
    		}
    		if c == '`' {
    			codeTicks ^= 1
    			b.WriteByte(c)
    			continue
    		}
    		if c == '|' && codeTicks == 0 {
    			cells = append(cells, strings.TrimSpace(b.String()))
    			b.Reset()
    			continue
    		}
    		b.WriteByte(c)
    	}
    	if escaped {
    		b.WriteByte('\\')
    	}
    	cells = append(cells, strings.TrimSpace(b.String()))
    	return cells
    }

    func convertPipeTable(lines []string, start int, stats *Stats) (int, []string) {
    	header := splitPipeRow(lines[start])
    	cols := len(header)
    	rows := [][]string{header}
    	i := start + 2
    	for i < len(lines) && strings.TrimSpace(lines[i]) != "" && looksPipeRow(lines[i]) {
    		row := splitPipeRow(lines[i])
    		if len(row) > cols {
    			cols = len(row)
    		}
    		rows = append(rows, row)
    		i++
    	}
    	for r := range rows {
    		for len(rows[r]) < cols {
    			rows[r] = append(rows[r], "")
    		}
    		for c := range rows[r] {
    			rows[r][c] = normalizeInline(rows[r][c], stats)
    		}
    	}
    	widths := make([]int, cols)
    	for _, row := range rows {
    		for c, cell := range row {
    			w := utf8.RuneCountInString(cell)
    			if w > widths[c] {
    				widths[c] = w
    			}
    		}
    	}
    	border := func(fill rune) string {
    		var b strings.Builder
    		b.WriteByte('+')
    		for _, w := range widths {
    			b.WriteString(strings.Repeat(string(fill), w+2))
    			b.WriteByte('+')
    		}
    		return b.String()
    	}
    	render := func(row []string) string {
    		var b strings.Builder
    		b.WriteByte('|')
    		for c, cell := range row {
    			b.WriteByte(' ')
    			b.WriteString(cell)
    			b.WriteString(strings.Repeat(" ", widths[c]-utf8.RuneCountInString(cell)+1))
    			b.WriteByte('|')
    		}
    		return b.String()
    	}
    	var out []string
    	out = append(out, border('-'), render(rows[0]), border('='))
    	for _, row := range rows[1:] {
    		out = append(out, render(row), border('-'))
    	}
    	return i, out
    }

    func normalizeQuoteLine(line string, stats *Stats) string {
    	t := strings.TrimLeft(line, " \t")
    	depth := 0
    	for strings.HasPrefix(t, ">") {
    		depth++
    		t = strings.TrimPrefix(t, ">")
    		if strings.HasPrefix(t, " ") {
    			t = t[1:]
    		}
    	}
    	return strings.Repeat("    ", depth) + normalizeInline(t, stats)
    }

    func isThematicBreak(s string) bool {
    	t := strings.ReplaceAll(strings.TrimSpace(s), " ", "")
    	if len(t) < 3 {
    		return false
    	}
    	ch := t[0]
    	if ch != '-' && ch != '*' && ch != '_' {
    		return false
    	}
    	for i := 1; i < len(t); i++ {
    		if t[i] != ch {
    			return false
    		}
    	}
    	return true
    }

    func normalizeInline(s string, stats *Stats) string {
    	if s == "" {
    		return s
    	}

    	s = autoLinkRE.ReplaceAllString(s, "$1")

    	s = mdImageRE.ReplaceAllStringFunc(s, func(m string) string {
    		sub := mdImageRE.FindStringSubmatch(m)
    		stats.Images++
    		alt := strings.TrimSpace(sub[1])
    		if alt == "" {
    			return sub[2]
    		}
    		return alt + " (" + sub[2] + ")"
    	})
    	s = mdLinkRE.ReplaceAllStringFunc(s, func(m string) string {
    		sub := mdLinkRE.FindStringSubmatch(m)
    		stats.Links++
    		return "`" + sub[1] + " <" + sub[2] + ">`_"
    	})
    	s = mdRefLinkRE.ReplaceAllStringFunc(s, func(m string) string {
    		sub := mdRefLinkRE.FindStringSubmatch(m)
    		stats.Links++
    		return "`" + sub[1] + " <" + sub[2] + "_>`_"
    	})
    	s = mdFootnoteRE.ReplaceAllStringFunc(s, func(m string) string {
    		sub := mdFootnoteRE.FindStringSubmatch(m)
    		stats.References++
    		return "[" + sub[1] + "]_"
    	})
    	s = strikeRE.ReplaceAllString(s, "$1")
    	s = normalizeBackticks(s, stats)
    	return s
    }

    func normalizeBackticks(s string, stats *Stats) string {
    	var b strings.Builder
    	for i := 0; i < len(s); {
    		if s[i] != '`' {
    			b.WriteByte(s[i])
    			i++
    			continue
    		}
    		run := 1
    		for i+run < len(s) && s[i+run] == '`' {
    			run++
    		}
    		if run >= 2 {
    			end := strings.Index(s[i+run:], strings.Repeat("`", run))
    			if end < 0 {
    				b.WriteString(s[i : i+run])
    				i += run
    				continue
    			}
    			end += i + run
    			b.WriteString(s[i : end+run])
    			i = end + run
    			continue
    		}

    		end := strings.IndexByte(s[i+1:], '`')
    		if end < 0 {
    			b.WriteByte('`')
    			i++
    			continue
    		}
    		end += i + 1
    		rolePrefix := i > 0 && s[i-1] == ':'
    		rstRef := end+1 < len(s) && s[end+1] == '_'
    		if rolePrefix || rstRef {
    			b.WriteString(s[i : end+1])
    			i = end + 1
    			continue
    		}
    		content := s[i+1 : end]
    		if strings.HasPrefix(content, " ") && strings.HasSuffix(content, " ") && len(content) > 2 {
    			content = content[1 : len(content)-1]
    		}
    		b.WriteString("``")
    		b.WriteString(content)
    		b.WriteString("``")
    		stats.InlineCode++
    		i = end + 1
    	}
    	return b.String()
    }

    func appendNormal(out *[]outLine, s string) {
    	*out = append(*out, outLine{text: s})
    }

    func appendRaw(out *[]outLine, s string) {
    	*out = append(*out, outLine{text: s, raw: true})
    }

    func ensureBlankBefore(out *[]outLine) {
    	if len(*out) == 0 {
    		return
    	}
    	if strings.TrimSpace((*out)[len(*out)-1].text) != "" {
    		appendNormal(out, "")
    	}
    }

    func lastNonBlank(out []outLine) int {
    	for i := len(out) - 1; i >= 0; i-- {
    		if strings.TrimSpace(out[i].text) != "" {
    			return i
    		}
    	}
    	return -1
    }

    func compactNormalBlankLines(in []outLine) []outLine {
    	out := make([]outLine, 0, len(in))
    	normalBlank := false
    	for _, l := range in {
    		if l.raw {
    			out = append(out, l)
    			normalBlank = false
    			continue
    		}
    		if strings.TrimSpace(l.text) == "" {
    			if normalBlank {
    				continue
    			}
    			normalBlank = true
    			out = append(out, outLine{text: ""})
    			continue
    		}
    		normalBlank = false
    		out = append(out, outLine{text: rtrim(l.text)})
    	}
    	return out
    }

    func rtrim(s string) string {
    	return strings.TrimRight(s, " \t")
    }

    func prevNonBlank(lines []string, i int) int {
    	for ; i >= 0; i-- {
    		if strings.TrimSpace(lines[i]) != "" {
    			return i
    		}
    	}
    	return -1
    }

    func nextNonBlank(lines []string, i int) int {
    	for ; i < len(lines); i++ {
    		if strings.TrimSpace(lines[i]) != "" {
    			return i
    		}
    	}
    	return -1
    }

    func onlyBlankAfter(lines []string, i int) bool {
    	for ; i < len(lines); i++ {
    		if strings.TrimSpace(lines[i]) != "" {
    			return false
    		}
    	}
    	return true
    }
  internal/normalize/normalize_test.go: |
    package normalize

    import (
    	"strings"
    	"testing"
    )

    func TestMarkdownToRST(t *testing.T) {
    	in := `# Project

    ## Overview

    Use ` + "`code`" + ` and [docs](https://example.com).

    - one
    + two
    3) three

    > quoted

    ` + "```go" + `
    fmt.Println("hi")
    ` + "```" + `
    `
    	wantContains := []string{
    		"Project\n=======",
    		"Overview\n--------",
    		"Use ``code`` and `docs <https://example.com>`_.",
    		"* one\n* two\n3. three",
    		"    quoted",
    		".. code-block:: go\n\n    fmt.Println(\"hi\")",
    	}
    	got, _ := Normalize(in)
    	for _, want := range wantContains {
    		if !strings.Contains(got, want) {
    			t.Fatalf("missing %q in:\n%s", want, got)
    		}
    	}
    }

    func TestPlanStyleLeakedFenceBecomesHeading(t *testing.T) {
    	in := "## Architecture\n\nData Plane\n\n```\n\nLatency-sensitive functionality remains native.\n\nControl and Debug Plane\n```\n\nLua provides diagnostics.\n"
    	got, st := Normalize(in)
    	if st.RepairedFences != 2 {
    		t.Fatalf("repaired fences = %d, want 2", st.RepairedFences)
    	}
    	if strings.Contains(got, "```") {
    		t.Fatalf("stray markdown fence survived:\n%s", got)
    	}
    	if !strings.Contains(got, "Data Plane\n~~~~~~~~~~") {
    		t.Fatalf("Data Plane not converted to level-3 heading:\n%s", got)
    	}
    	if !strings.Contains(got, "Control and Debug Plane\n~~~~~~~~~~~~~~~~~~~~~~~") {
    		t.Fatalf("Control heading not converted:\n%s", got)
    	}
    }

    func TestRSTLiteralWithMarkdownFenceWrapper(t *testing.T) {
    	in := "Example:\n\n::\n\n```\nhello *world*\n```\n"
    	got, _ := Normalize(in)
    	if strings.Count(got, "::") != 1 {
    		t.Fatalf("expected exactly one literal introducer:\n%s", got)
    	}
    	if !strings.Contains(got, "    hello *world*") {
    		t.Fatalf("code content not preserved:\n%s", got)
    	}
    }

    func TestPipeTable(t *testing.T) {
    	in := "| Name | Value |\n| --- | ---: |\n| a | `b` |\n"
    	got, _ := Normalize(in)
    	want := "+------+-------+\n| Name | Value |\n+======+=======+\n| a    | ``b`` |\n+------+-------+"
    	if !strings.Contains(got, want) {
    		t.Fatalf("table mismatch; got:\n%s", got)
    	}
    }

    func TestReferencesImagesAndFootnotes(t *testing.T) {
    	in := "![logo](logo.png)\n\n[site]: https://example.com\n\nSee [Example][site] and note[^1].\n\n[^1]: detail\n"
    	got, _ := Normalize(in)
    	for _, want := range []string{
    		".. image:: logo.png\n   :alt: logo",
    		".. _site: https://example.com",
    		"`Example <site_>`_",
    		"note[1]_",
    		".. [1] detail",
    	} {
    		if !strings.Contains(got, want) {
    			t.Fatalf("missing %q in:\n%s", want, got)
    		}
    	}
    }

    func TestIdempotent(t *testing.T) {
    	in := "# T\n\nUse `x`.\n\n```bash\necho hi\n```\n"
    	once, _ := Normalize(in)
    	twice, _ := Normalize(once)
    	if once != twice {
    		t.Fatalf("normalization is not idempotent\n--- once ---\n%s\n--- twice ---\n%s", once, twice)
    	}
    }
  README.rst: |
    rst-fixup-chatgpt
    ===============

    ``rst-fixup-chatgpt`` is a Go command-line formatter for ``.rst`` files that have
    accidentally accumulated Markdown syntax.

    It deliberately uses two stages:

    1. a mixed Markdown/rST repair pass converts obvious Markdown constructs and a
       few malformed mixed-syntax patterns into valid rST;
    2. the repaired result is written to a temporary input file and rendered through
       Pandoc with ``pandoc -f rst -t rst --wrap=auto --columns=120 inp.rst``.

    Pandoc is therefore a runtime dependency. The Go binary invokes it directly as a
    subprocess rather than through a command shell.

    Safety and default behaviour
    ----------------------------

    For a named input file, normalization is **in place by default**::

        rst-fixup-chatgpt PLAN.rst

    The original file is not opened for writing until both stages have succeeded.
    The replacement itself is atomic: the complete result is written to a temporary
    file in the same directory, flushed and then renamed over the original. The
    original permission bits are retained.

    Use ``-stdout`` to preview a named file without modifying it::

        rst-fixup-chatgpt -stdout PLAN.rst

    ``-w`` remains accepted for compatibility, but is redundant because a named file
    is already in-place by default.

    Supported mixed-syntax repair
    -----------------------------

    The first stage currently handles, among other things:

    * Markdown ATX headings (``#`` through ``######``) to rST headings;
    * existing rST/setext headings to a deterministic adornment sequence;
    * Markdown fenced code blocks to rST literal/code blocks;
    * fenced code redundantly wrapped around an existing rST ``::`` literal block;
    * conservative repair of stray bare backtick fences placed after title-like
      subsection names;
    * Markdown inline code to rST inline literals;
    * inline Markdown links, reference links, autolinks and numeric footnotes;
    * block Markdown images to ``.. image::`` directives;
    * GFM pipe tables to rST grid tables;
    * Markdown block quotes to rST indentation;
    * Markdown bullets and ordered-list markers to rST list syntax;
    * Markdown reference definitions to rST explicit targets;
    * Markdown thematic breaks to rST transitions;
    * CRLF/CR input to LF and ordinary trailing-whitespace cleanup.

    Pandoc then owns the final rST parse/render pass and line wrapping at 120 columns.

    Usage
    -----

    Normalize and replace a file atomically (default)::

        rst-fixup-chatgpt PLAN.rst

    Preview the result on stdout::

        rst-fixup-chatgpt -stdout PLAN.rst

    Write to a separate file::

        rst-fixup-chatgpt -o PLAN.clean.rst PLAN.rst

    Use it as a formatter check in CI without modifying anything::

        rst-fixup-chatgpt -check PLAN.rst

    Read from stdin; stdin always implies stdout unless ``-o`` is used::

        cat PLAN.rst | rst-fixup-chatgpt > PLAN.clean.rst

    Print conversion statistics and warnings::

        rst-fixup-chatgpt -v PLAN.rst

    Build
    -----

    The ``.siml`` build isolates Go's normal temporary directory, Go build-work
    directory, cache and GOPATH below hacman's work directory. This avoids Go's
    special handling of a ``go.mod`` located directly at the system temporary root.

    The build verifies that ``pandoc`` is available, runs the Go tests and then
    builds the binary. ``GOTOOLCHAIN=auto`` remains enabled for toolchain selection.
