#!/usr/bin/env hacman
# Keep a private AWS CLI v2 current, then forward commands such as
# `./examples/aws.siml sts get-caller-identity` to it.
name: aws-cli
command: sh update-aws.sh
schedule: daily
bin-path: bin/aws
files:
  update-aws.sh: |
    #!/bin/sh
    set -eu

    # AWS publishes separate CLI archives for the supported Linux architectures.
    case "$(uname -m)" in
      x86_64|amd64) release_arch=x86_64 ;;
      aarch64|arm64) release_arch=aarch64 ;;
      *)
        echo "aws-cli: unsupported Linux architecture: $(uname -m)" >&2
        exit 1
        ;;
    esac

    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    archive="awscli-exe-linux-$release_arch.zip"
    curl -fsSL "https://awscli.amazonaws.com/$archive" -o "$tmp/$archive"
    unzip -q "$tmp/$archive" -d "$tmp"

    # The archive's installer needs --update after the initial private install.
    if [ -x "$PWD/bin/aws" ]; then
      "$tmp/aws/install" --install-dir "$PWD/aws-cli" \
        --bin-dir "$PWD/bin" --update
    else
      "$tmp/aws/install" --install-dir "$PWD/aws-cli" \
        --bin-dir "$PWD/bin"
    fi
