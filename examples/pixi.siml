#!/usr/bin/env hacman
# Read the version off the public releases Atom feed rather than the GitHub
# API: the API's unauthenticated rate limit (60 requests/hour, shared by
# every project on this machine that polls it) is easy to exhaust, while the
# feed is served without that limit. The feed lists releases newest first,
# but it also carries tags for pixi's separately released build backends
# (pixi-build-rust-v0.5.7, ...), which can sort ahead of the pixi release.
# Anchoring the prefix on `tag/v` skips those, since they all start with
# `pixi-`, and picks the newest plain `vX.Y.Z` tag. The `v` is therefore
# not part of the extracted version and gets re-added in the download URL.
# pixi also publishes a bare per-architecture binary alongside the tarball,
# so the install block downloads it directly instead of unpacking an archive.
name: pixi
url: https://github.com/prefix-dev/pixi/releases.atom
check: version
version-prefix: https://github.com/prefix-dev/pixi/releases/tag/v
version-suffix: "
schedule: daily
bin-path: pixi
install: |
  set -eu
  echo "installing pixi $HACMAN_VERSION (was: ${HACMAN_PREVIOUS:-none})"

  case "$(uname -m)" in
    x86_64|amd64) release_arch=x86_64 ;;
    aarch64|arm64) release_arch=aarch64 ;;
    *)
      echo "pixi: unsupported Linux architecture: $(uname -m)" >&2
      exit 1
      ;;
  esac

  asset="pixi-${release_arch}-unknown-linux-musl"
  url="https://github.com/prefix-dev/pixi/releases/download/v$HACMAN_VERSION/$asset"
  curl -fsSL "$url" -o pixi.next
  chmod 755 pixi.next
  ./pixi.next --version >/dev/null

  # Replace the cached executable only after the new release runs successfully.
  mv pixi.next pixi
