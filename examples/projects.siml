# hacman project list - see README.md.
# Each entry describes one URL to watch, when to look at it (schedule) and how
# to decide that it changed (check).
# Note that SIML allows no blank lines outside of block scalars.
- name: ripgrep
  url: https://api.github.com/repos/BurntSushi/ripgrep/releases/latest
  check: version
  version-prefix: "tag_name": "
  version-suffix: "
  schedule: daily
  install: |
    set -eu
    echo "installing ripgrep $HACMAN_VERSION (was: ${HACMAN_PREVIOUS:-none})"
    tarball="ripgrep-${HACMAN_VERSION}-x86_64-unknown-linux-musl.tar.gz"
    url="https://github.com/BurntSushi/ripgrep/releases/download/$HACMAN_VERSION/$tarball"
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSL "$url" | tar -xz -C "$tmp" --strip-components=1
    install -Dm755 "$tmp/rg" "$HOME/.local/bin/rg"
# A plain "did this URL change at all" watch: only the server's validators are
# compared, so nothing but headers is transferred.
- name: nixpkgs-unstable
  url: https://channels.nixos.org/nixpkgs-unstable/git-revision
  check: etag
  schedule: 6h
  install: |
    set -eu
    echo "nixpkgs-unstable moved to $HACMAN_VERSION"
    nix flake update --flake "$HOME/workspace/nixcfg"
# `check: hash` fingerprints the whole body - use it for URLs that serve no
# useful validators. The downloaded body is handed to the script as
# $HACMAN_RESPONSE, so it does not have to be fetched twice.
- name: hosts-blocklist
  url: https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
  check: hash
  schedule: weekly
  install: |
    set -eu
    sudo install -Dm644 "$HACMAN_RESPONSE" /etc/hosts.blocklist
# A single-line install script is fine too, as is a schedule that only ever
# runs under `hacman --force`.
- name: go
  url: https://go.dev/VERSION?m=text
  check: hash
  schedule: never
  install: echo "go moved, see https://go.dev/dl/"
