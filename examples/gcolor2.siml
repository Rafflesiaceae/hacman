#!/usr/bin/env hacman
# Keep a local build of gcolor2, GNOME's old GTK+2 color picker, current,
# then launch it with `./examples/gcolor2.siml`. Upstream never released
# past 0.4 (2009), so there is no version feed to poll: Debian mirrors the
# untouched upstream tarball unchanged, and `check: hash` fingerprints its
# body directly. Building it needs a C toolchain, pkg-config, patch(1) and
# the GTK+2 development headers.
name: gcolor2
url: https://snapshot.debian.org/archive/debian/20051016T000000Z/pool/main/g/gcolor2/gcolor2_0.4.orig.tar.gz
check: hash
schedule: weekly
bin-path: gcolor2/src/gcolor2
install: |
  set -eu

  # Recover the last good build if a previous replacement was interrupted.
  previous="$PWD/.gcolor2-previous"
  if [ ! -d "$PWD/gcolor2" ] && [ -d "$previous" ]; then
    mv "$previous" "$PWD/gcolor2"
  fi
  rm -rf "$previous"

  stage="$(mktemp -d "$PWD/.gcolor2-update.XXXXXX")"
  trap 'rm -rf "$stage"' EXIT
  tar -xzf "$HACMAN_RESPONSE" -C "$stage"
  mv "$stage/gcolor2-0.4" "$stage/gcolor2"

  # This 2005 configure script's Gentoo ltmain.sh version check uses a
  # bracket expression missing its outer pair ([:space:] instead of
  # [[:space:]]). Current grep/sed correctly reject that as invalid,
  # which empties the parsed version and hard-fails the check on every
  # current system, not just Gentoo.
  sed -i 's/\[:space:\]/[[:space:]]/g' "$stage/gcolor2/configure"

  # gcolor2 0.4 predates C99-strict compilers and GCC 10's -fno-common
  # default: without this patch it fails to build with implicit
  # function declarations and, once past that, with duplicate-symbol
  # link errors for globals declared (not just extern'd) in a header.
  patch -d "$stage/gcolor2" -p1 <<'GCOLOR2_AMD64_PATCH'
  diff --exclude-from=/home/dang/bin/scripts/diffrc -up -ruN gcolor2-0.4.orig/src/callbacks.c gcolor2-0.4/src/callbacks.c
  --- gcolor2-0.4.orig/src/callbacks.c	2005-07-12 14:06:12.000000000 -0400
  +++ gcolor2-0.4/src/callbacks.c	2007-02-17 19:19:38.000000000 -0500
  @@ -4,6 +4,9 @@

   #include <gtk/gtk.h>
   #include <stdio.h>
  +#include <string.h>
  +#include <glib.h>
  +#include <glib/gprintf.h>

   #include "callbacks.h"
   #include "interface.h"
  @@ -172,6 +175,9 @@ void on_copy_color_to_clipboard_activate
   	gtk_clipboard_set_text (cb, hex, strlen (hex));
   }

  +void add_rgb_file (gchar *filename, gchar *type);
  +gchar* get_system_file (void);
  +
   void on_show_system_colors_activate (GtkMenuItem *menuitem, gpointer user_data)
   {
   	if (gtk_check_menu_item_get_active (GTK_CHECK_MENU_ITEM (menuitem)))
  @@ -266,6 +272,8 @@ void on_save_button_clicked (GtkButton *
   	gtk_widget_destroy (savedialog);
   }

  +void add_list_color (gchar *spec, gchar *name, gchar *type, gboolean is_new_color);
  +
   void add_color_to_treeview ()
   {
   	GtkTreeView      *treeview;
  diff --exclude-from=/home/dang/bin/scripts/diffrc -up -ruN gcolor2-0.4.orig/src/main.c gcolor2-0.4/src/main.c
  --- gcolor2-0.4.orig/src/main.c	2005-07-11 10:55:49.000000000 -0400
  +++ gcolor2-0.4/src/main.c	2007-02-17 19:18:23.000000000 -0500
  @@ -4,6 +4,10 @@

   #include <gtk/gtk.h>
   #include <stdio.h>
  +#include <stdlib.h>
  +#include <string.h>
  +#include <glib.h>
  +#include <glib/gprintf.h>

   #include "interface.h"
   #include "support.h"
  GCOLOR2_AMD64_PATCH

  (cd "$stage/gcolor2" && ./configure >/dev/null && make CFLAGS="-g -O2 -fcommon" >/dev/null)
  test -x "$stage/gcolor2/src/gcolor2"

  # Rotate only after the freshly built binary lands in place.
  if [ -d "$PWD/gcolor2" ]; then
    mv "$PWD/gcolor2" "$previous"
  fi
  if mv "$stage/gcolor2" "$PWD/gcolor2"; then
    rm -rf "$previous"
  else
    if [ -d "$previous" ]; then
      mv "$previous" "$PWD/gcolor2"
    fi
    exit 1
  fi
