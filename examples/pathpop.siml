#!/usr/bin/env hacman
# XCB event/window handling + Xft rendering (Xlib only for Xft).
# Native X11 popup; PATH scanning runs asynchronously in a child process.
name: pathpop
command: (test -f build/build.ninja || meson setup build --buildtype=release) && meson compile -C build
bin-path: build/pathpop
files:
  main.c: |
    #define _GNU_SOURCE
    #include <xcb/xcb.h>
    #ifdef HAVE_RANDR
    #include <xcb/randr.h>
    #endif
    #include <X11/Xlib.h>
    #include <X11/Xlib-xcb.h>
    #include <X11/Xft/Xft.h>
    #include <X11/keysym.h>
    #include <ctype.h>
    #include <dirent.h>
    #include <errno.h>
    #include <fcntl.h>
    #include <limits.h>
    #include <poll.h>
    #include <signal.h>
    #include <stdbool.h>
    #include <stdint.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <sys/stat.h>
    #include <unistd.h>

    /* XCB owns the event queue; Xlib is used only by Xft.
       Editable input is ASCII-oriented, but result labels support UTF-8. */
    enum { WIDTH=680, ROWS=8, MAX_QUERY=255, MAX_LINE=8192, HASH_INIT=4096,
           LEGEND_COLS=3, LEGEND_PAD_X=18, LEGEND_PAD_Y=9,
           LEGEND_GAP_X=8, LEGEND_GAP_Y=7,
           LEGEND_BUTTON_HEIGHT=44, /* Edit this to resize shortcut buttons (pixels). */
           WHEEL_LINES=3 };

    typedef struct { char *label, *path; bool desktop; } Entry;
    typedef struct { xcb_keysym_t sym; char *key, *command; } Shortcut;
    typedef struct { int entry, score; } Match;
    /* Cache opened fallback faces and failed lookups for this popup's lifetime. */
    typedef struct FontFallback {
        XftFont *base, *font;
        FcChar32 missing;
        struct FontFallback *next;
    } FontFallback;
    enum { GC_BG, GC_BORDER, GC_SELECT, GC_ACCENT, GC_CURSOR,
           GC_BUTTON, GC_BUTTON_HOVER, GC_ROW_HOVER, GC_ROW_HOVER_ACCENT,
           GC_COUNT };
    enum { TEXT_MAIN, TEXT_DIM, TEXT_MUTED, TEXT_GREEN, TEXT_BLUE, TEXT_COUNT };
    typedef struct {
        Display *dpy;
        xcb_connection_t *conn;
        xcb_screen_t *screen;
        xcb_window_t win;
        xcb_pixmap_t back_pixmap; /* Allocated only in double-buffered mode. */
        xcb_drawable_t paint_target; /* Pixmap by default, window with --no-double-buffering. */
        xcb_gcontext_t gc[GC_COUNT];
        XftDraw *draw;
        XftFont *font, *bold_font;
        bool font_ascii, bold_ascii;
        FontFallback *fallbacks;
        XftColor ink[TEXT_COUNT];
        xcb_get_keyboard_mapping_reply_t *keymap;
        uint8_t mincode;
        int x, y, width, height, header, row_h, footer, font_size;
        int visible_rows, legend_rows, legend_row_h, legend_h, bottom_pad;
        int ascent, descent;
        int hovered_short, hovered_result, pointer_x, pointer_y;
        char *font_pattern;
        char query[MAX_QUERY+1];
        int qlen, cursor, selected;
        Entry *entries;
        size_t count, capacity;
        char **hash;
        size_t hash_cap;
        int scan_fd;
        bool scan_finished;
        char partial[MAX_LINE];
        size_t partial_len;
        Match *matches;
        size_t match_capacity;
        int match_count, scroll;
        Shortcut *shorts;
        size_t short_count;
        bool desktop_mode, no_count, no_remember, no_double_buffering;
        bool fuzz_char_swap;
        bool hint_active, remembered_found;
        Entry remembered;
        /* Damage tracking: mouse movement never repaints the whole window. */
        bool redraw_header, redraw_results, redraw_count;
        unsigned dirty_rows; /* bit per visible result row (ROWS <= 8) */
        bool button_hover_dirty;
        int previous_hover_short;
    } App;

    static void fatal(const char *msg) { perror(msg); exit(1); }
    static int lower(int c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }
    static bool endswith(const char *s, const char *suffix) {
        size_t a=strlen(s), b=strlen(suffix);
        return a>=b && !strcmp(s+a-b,suffix);
    }
    /* XDG_STATE_HOME is for persistent user preferences, not a cache. */
    static char *state_file_path(void) {
        const char *base=getenv("XDG_STATE_HOME");
        char *path=NULL;
        if (base && base[0]=='/') {
            if (asprintf(&path,"%s/pathpop/last-selection",base)<0) return NULL;
        } else {
            const char *home=getenv("HOME");
            if (!home || home[0]!='/') return NULL;
            if (asprintf(&path,"%s/.local/state/pathpop/last-selection",home)<0) return NULL;
        }
        return path;
    }
    static void strip_newline(char *s) {
        size_t n=strlen(s);
        while (n && (s[n-1]=='\n' || s[n-1]=='\r')) s[--n]=0;
    }
    static void load_remembered(App *a) {
        if (a->no_remember) return;
        char *path=state_file_path();
        if (!path) return;
        FILE *f=fopen(path,"r"); free(path);
        if (!f) return;
        char *kind=NULL, *label=NULL, *desktop_path=NULL;
        size_t kc=0,lc=0,pc=0;
        ssize_t kn=getline(&kind,&kc,f);
        ssize_t ln=getline(&label,&lc,f);
        ssize_t pn=getline(&desktop_path,&pc,f);
        fclose(f);
        if (kn>0 && ln>1 && ln<=MAX_LINE && pn>0 && pn<=MAX_LINE) {
            strip_newline(kind); strip_newline(label); strip_newline(desktop_path);
            if ((!strcmp(kind,"P") || !strcmp(kind,"D")) && *label &&
                !strchr(label,'\t') &&
                (kind[0]=='P' || (*desktop_path && desktop_path[0]=='/'))) {
                a->remembered=(Entry){ .label=label,
                    .path=kind[0]=='D' ? desktop_path : NULL,
                    .desktop=kind[0]=='D' };
                a->hint_active=true;
                label=NULL;
                if (a->remembered.desktop) desktop_path=NULL;
            }
        }
        free(kind); free(label); free(desktop_path);
    }
    static int create_state_dirs(char *path) {
        /* Create only the directories leading to this file. */
        for (char *p=path+1;*p;p++) {
            if (*p!='/') continue;
            *p=0;
            int rc=mkdir(path,0700);
            int err=errno;
            *p='/';
            if (rc<0 && err!=EEXIST) return -1;
        }
        return 0;
    }
    static void save_remembered(App *a, const Entry *entry) {
        if (a->no_remember || !entry || !entry->label ||
            strchr(entry->label,'\n') || strchr(entry->label,'\r') ||
            (entry->desktop && (!entry->path || strchr(entry->path,'\n') ||
                                strchr(entry->path,'\r')))) return;
        char *path=state_file_path();
        if (!path) return;
        if (create_state_dirs(path)<0) { free(path); return; }
        char *temp=NULL;
        if (asprintf(&temp,"%s.tmp.%ld",path,(long)getpid())<0) {
            free(path); return;
        }
        int fd=open(temp,O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC,0600);
        if (fd<0) { free(path); free(temp); return; }
        FILE *f=fdopen(fd,"w");
        if (!f) { close(fd); unlink(temp); free(path); free(temp); return; }
        bool ok=fprintf(f,"%c\n%s\n%s\n",entry->desktop?'D':'P',
                        entry->label,entry->desktop?entry->path:"")>=0;
        if (fclose(f)!=0) ok=false;
        if (!ok || rename(temp,path)!=0) unlink(temp);
        free(temp); free(path);
    }
    static uint64_t hashstr(const char *s) {
        uint64_t h=UINT64_C(14695981039346656037);
        while (*s) { h^=(unsigned char)*s++; h*=UINT64_C(1099511628211); }
        return h;
    }
    static void resize_hash(App *a) {
        size_t next=a->hash_cap ? a->hash_cap*2 : HASH_INIT;
        char **slots=calloc(next,sizeof(*slots));
        if (!slots) fatal("calloc");
        for (size_t i=0;i<a->hash_cap;i++) {
            if (!a->hash[i]) continue;
            size_t j=hashstr(a->hash[i]) & (next-1);
            while (slots[j]) j=(j+1)&(next-1);
            slots[j]=a->hash[i];
        }
        free(a->hash); a->hash=slots; a->hash_cap=next;
    }
    static void add_entry(App *a, const char *label, const char *path, bool desktop) {
        if (!*label) return;
        /* Dedupe labels by exact name; the first PATH/XDG match wins. */
        if ((a->count+1)*10 >= a->hash_cap*7) resize_hash(a);
        size_t slot=hashstr(label)&(a->hash_cap-1);
        while (a->hash[slot]) {
            if (!strcmp(a->hash[slot],label)) return;
            slot=(slot+1)&(a->hash_cap-1);
        }
        if (a->count==a->capacity) {
            size_t cap=a->capacity ? a->capacity*2 : 1024;
            Entry *p=realloc(a->entries,cap*sizeof(*p));
            if (!p) fatal("realloc");
            a->entries=p; a->capacity=cap;
        }
        Entry *e=&a->entries[a->count++];
        e->label=strdup(label);
        e->path=path ? strdup(path) : NULL;
        e->desktop=desktop;
        if (!e->label || (path && !e->path)) fatal("strdup");
        a->hash[slot]=e->label;
    }
    static int score(const char *name, const char *query) {
        if (!*query) return 0;
        size_t nl=strlen(name), ql=strlen(query), i=0;
        if (nl==ql) {
            /* Prefer the exact spelling and capitalization of the query.
               A case-insensitive full-name match remains a close second. */
            if (!strcmp(name,query)) return 0;
            for (;i<ql && lower((unsigned char)name[i])==lower((unsigned char)query[i]);i++);
            if (i==ql) return 1;
        }
        for (i=0;i<ql && i<nl && lower((unsigned char)name[i])==lower((unsigned char)query[i]);i++);
        if (i==ql) return 100+(int)(nl-ql);
        for (size_t p=0;p+ql<=nl;p++) {
            for (i=0;i<ql && lower((unsigned char)name[p+i])==lower((unsigned char)query[i]);i++);
            if (i==ql) return 400+(int)(p*8+nl-ql);
        }
        size_t last=0, qi=0; int gaps=0;
        for (size_t p=0;p<nl && qi<ql;p++) {
            if (lower((unsigned char)name[p])==lower((unsigned char)query[qi])) {
                if (qi) gaps+=(int)(p-last-1);
                last=p; qi++;
            }
        }
        return qi==ql ? 1000+gaps*8+(int)nl : -1;
    }
    /* Match one adjacent transposition in a contiguous query-length span.
       All other characters must agree, case-insensitively. The two swapped
       characters must differ; swapping identical characters is not a typo. */
    static bool matches_one_swap(const char *name, const char *query, size_t ql) {
        bool swapped=false;
        for (size_t i=0;i<ql;) {
            if (lower((unsigned char)name[i])==lower((unsigned char)query[i])) {
                i++;
                continue;
            }
            if (swapped || i+1>=ql ||
                lower((unsigned char)name[i])!=lower((unsigned char)query[i+1]) ||
                lower((unsigned char)name[i+1])!=lower((unsigned char)query[i]))
                return false;
            swapped=true;
            i+=2;
        }
        return swapped;
    }

    /* Transposition candidate categories: exact full name, prefix, substring.
       Do not permit additional fuzzy edits, insertions, or deletions. */
    enum { SWAP_EXACT=0, SWAP_PREFIX=1, SWAP_SUBSTRING=2 };
    static int score_one_swap(const char *name, const char *query, int *tier) {
        size_t nl=strlen(name), ql=strlen(query);
        if (ql<2 || nl<ql) return -1;
        if (nl==ql) {
            if (!matches_one_swap(name,query,ql)) return -1;
            *tier=SWAP_EXACT;
            return 50; /* After a true exact match (0), before regular prefix (100). */
        }
        if (matches_one_swap(name,query,ql)) {
            *tier=SWAP_PREFIX;
            return 200+(int)(nl-ql);
        }
        for (size_t pos=1;pos+ql<=nl;pos++) {
            if (matches_one_swap(name+pos,query,ql)) {
                *tier=SWAP_SUBSTRING;
                return 600+(int)(pos*8+nl-ql);
            }
        }
        return -1;
    }

    static int match_cmp(const void *lhs, const void *rhs, void *ctx) {
        const App *a=ctx;
        const Match *l=lhs, *r=rhs;
        if (l->score!=r->score) return l->score<r->score ? -1 : 1;
        const char *ln=a->entries[l->entry].label;
        const char *rn=a->entries[r->entry].label;
        /* When quality is otherwise tied, prefer names containing the
           query with matching capitalization (also for partial prefixes). */
        if (a->qlen) {
            bool lc=strstr(ln,a->query)!=NULL;
            bool rc=strstr(rn,a->query)!=NULL;
            if (lc!=rc) return lc ? -1 : 1;
        }
        return strcmp(ln,rn);
    }
    static void keep_selection_visible(App *a) {
        if (a->selected<a->scroll) a->scroll=a->selected;
        else if (a->selected>=a->scroll+a->visible_rows)
            a->scroll=a->selected-a->visible_rows+1;
        int max_scroll=a->match_count>a->visible_rows ? a->match_count-a->visible_rows : 0;
        if (a->scroll>max_scroll) a->scroll=max_scroll;
    }
    static bool is_remembered_entry(const App *a, const Entry *e) {
        return a->remembered.label && e->desktop==a->remembered.desktop &&
            !strcmp(e->label,a->remembered.label) &&
            (!e->desktop || (e->path && a->remembered.path &&
                             !strcmp(e->path,a->remembered.path)));
    }
    static void rank_matches(App *a) {
        /* Retain the whole sorted result list so wheel/keyboard scrolling can
           reach matches beyond the first ROWS. Re-rank after async scan batches. */
        if (a->match_capacity<a->count) {
            Match *p=realloc(a->matches,a->count*sizeof(*p));
            if (!p) fatal("realloc");
            a->matches=p; a->match_capacity=a->count;
        }
        /* Detect whether the query names a real command exactly. If so,
           do not suggest transposition alternatives at all. Otherwise find
           the highest-quality transposition tier across *all* commands. */
        int best_swap_tier=INT_MAX;
        if (a->fuzz_char_swap && a->qlen>=2) {
            for (size_t i=0;i<a->count;i++) {
                const char *name=a->entries[i].label;
                if (score(name,a->query)<=1) {
                    best_swap_tier=INT_MAX;
                    break;
                }
                int tier;
                if (score_one_swap(name,a->query,&tier)>=0 &&
                    tier<best_swap_tier) best_swap_tier=tier;
            }
        }
        a->match_count=0;
        for (size_t i=0;i<a->count;i++) {
            const char *name=a->entries[i].label;
            int sc=score(name,a->query);
            if (best_swap_tier!=INT_MAX) {
                int tier;
                int swap_sc=score_one_swap(name,a->query,&tier);
                if (swap_sc>=0 && tier==best_swap_tier &&
                    (sc<0 || swap_sc<sc)) sc=swap_sc;
            }
            /* Ambiguity must not hide a valid candidate. Multiple equally
               plausible corrections remain visible for explicit selection;
               unlike the old implementation, we never discard all matches
               when there is more than one swapped candidate. */
            if (sc>=0)
                a->matches[a->match_count++]=(Match){ .entry=(int)i,
                                                       .score=sc };
        }
        qsort_r(a->matches,(size_t)a->match_count,sizeof(*a->matches),match_cmp,a);
        a->remembered_found=false;
        if (a->hint_active) {
            /* The PATH scan is asynchronous. Keep selecting the *exact* saved
               entry as results arrive, rather than an arbitrary first row. */
            for (int i=0;i<a->match_count;i++) {
                if (is_remembered_entry(a,&a->entries[a->matches[i].entry])) {
                    a->selected=i;
                    a->remembered_found=true;
                    break;
                }
            }
            if (!a->remembered_found) { a->selected=0; a->scroll=0; }
        } else if (a->selected>=a->match_count) {
            a->selected=a->match_count ? a->match_count-1 : 0;
        }
        if (!a->hint_active || a->remembered_found) keep_selection_visible(a);
    }
    /* Move the selection and viewport by half the visible page.
       PageDown and PageUp use the same scrolling behavior. */
    static void half_page_move(App *a, int direction) {
        if (!a->match_count) return;
        int amount=a->visible_rows/2;
        if (amount<1) amount=1;
        int next=a->selected+direction*amount;
        if (next<0) next=0;
        if (next>=a->match_count) next=a->match_count-1;
        a->selected=next;
        int max_scroll=a->match_count>a->visible_rows ? a->match_count-a->visible_rows : 0;
        next=a->scroll+direction*amount;
        if (next<0) next=0;
        if (next>max_scroll) next=max_scroll;
        a->scroll=next;
        keep_selection_visible(a);
    }
    static void paint(App *a);
    static void mark_row_damage(App *a, int index) {
        int slot=index-a->scroll;
        if (slot>=0 && slot<a->visible_rows && slot<32)
            a->dirty_rows|=1u<<slot;
    }
    static void wheel_scroll(App *a, int direction) {
        int max_scroll=a->match_count>a->visible_rows ? a->match_count-a->visible_rows : 0;
        int next=a->scroll+direction*WHEEL_LINES;
        if (next<0) next=0;
        if (next>max_scroll) next=max_scroll;
        if (next==a->scroll) return;
        a->scroll=next;
        if (a->selected<a->scroll) a->selected=a->scroll;
        if (a->selected>=a->scroll+a->visible_rows)
            a->selected=a->scroll+a->visible_rows-1;
        a->redraw_results=true;
    }

    /* Base16 Kokonai. Both XCB and Xft paint to the same drawable:
       an off-screen pixmap by default, or the window with the opt-out. */
    static unsigned long channel_pixel(unsigned c, unsigned long mask) {
        if (!mask) return 0;
        unsigned shift=0;
        while (!(mask & 1)) { mask>>=1; shift++; }
        return (((unsigned long)c*mask + 127)/255) << shift;
    }
    static unsigned long pixel_for(Visual *visual, unsigned rgb) {
        return channel_pixel((rgb>>16)&255,visual->red_mask) |
               channel_pixel((rgb>>8)&255,visual->green_mask) |
               channel_pixel(rgb&255,visual->blue_mask);
    }
    static void init_color(App *a, int index, unsigned color) {
        XftColor *c=&a->ink[index];
        Visual *v=DefaultVisual(a->dpy,DefaultScreen(a->dpy));
        c->pixel=pixel_for(v,color);
        c->color.red=((color>>16)&255)*257;
        c->color.green=((color>>8)&255)*257;
        c->color.blue=(color&255)*257;
        c->color.alpha=65535;
    }
    static void make_gc(App *a, int i, unsigned color) {
        a->gc[i]=xcb_generate_id(a->conn);
        unsigned long px=pixel_for(DefaultVisual(a->dpy,DefaultScreen(a->dpy)),color);
        uint32_t v[]={(uint32_t)px};
        xcb_create_gc(a->conn,a->gc[i],a->win,XCB_GC_FOREGROUND,v);
    }
    static void shortcut_rect(const App *a, size_t i,
                              int *x, int *y, int *w, int *h) {
        int col_w=(a->width-2*LEGEND_PAD_X-(LEGEND_COLS-1)*LEGEND_GAP_X)/LEGEND_COLS;
        int col=(int)(i%LEGEND_COLS), row=(int)(i/LEGEND_COLS);
        *x=LEGEND_PAD_X+col*(col_w+LEGEND_GAP_X);
        *y=a->header+a->visible_rows*a->row_h+1+LEGEND_PAD_Y+
           row*(a->legend_row_h+LEGEND_GAP_Y);
        *w=col_w; *h=a->legend_row_h;
    }
    static int shortcut_at(const App *a, int px, int py) {
        for (size_t i=0;i<a->short_count;i++) {
            int x,y,w,h;
            shortcut_rect(a,i,&x,&y,&w,&h);
            if (px>=x && px<x+w && py>=y && py<y+h) return (int)i;
        }
        return -1;
    }
    static int result_at(const App *a, int x, int y) {
        if (x<0 || x>=a->width || y<a->header ||
            y>=a->header+a->visible_rows*a->row_h) return -1;
        int hit=a->scroll+(y-a->header)/a->row_h;
        return hit<a->match_count ? hit : -1;
    }
    static void mark_row_damage(App *a, int index);
    static void refresh_hover(App *a) {
        a->hovered_short=shortcut_at(a,a->pointer_x,a->pointer_y);
        a->hovered_result=result_at(a,a->pointer_x,a->pointer_y);
    }
    static void set_pointer_hover(App *a, int x, int y) {
        int old_short=a->hovered_short, old_result=a->hovered_result;
        a->pointer_x=x; a->pointer_y=y;
        refresh_hover(a);
        if (old_result!=a->hovered_result) {
            mark_row_damage(a,old_result);
            mark_row_damage(a,a->hovered_result);
        }
        if (old_short!=a->hovered_short) {
            if (!a->button_hover_dirty) a->previous_hover_short=old_short;
            a->button_hover_dirty=true;
        }
    }
    static void rect(App *a, int gc, int x, int y, int w, int h) {
        if (w<=0 || h<=0) return;
        xcb_rectangle_t r={(int16_t)x,(int16_t)y,(uint16_t)w,(uint16_t)h};
        xcb_poly_fill_rectangle(a->conn,a->paint_target,a->gc[gc],1,&r);
    }
    static XftFont *font_for_char(App *a, XftFont *base, FcChar32 codepoint) {
        if (XftCharExists(a->dpy,base,codepoint)) return base;
        for (FontFallback *f=a->fallbacks;f;f=f->next) {
            if (f->base!=base) continue;
            if (f->font && XftCharExists(a->dpy,f->font,codepoint)) return f->font;
            if (!f->font && f->missing==codepoint) return base;
        }
        /* Match from the user's request, not the resolved face's file/charset.
           Keep the actual pixel size and the shortcut button's bold weight. */
        FcPattern *pattern=FcNameParse((const FcChar8*)a->font_pattern);
        FcCharSet *charset=FcCharSetCreate();
        if (!pattern || !charset) fatal("font fallback");
        FcPatternDel(pattern,FC_FILE);
        FcPatternDel(pattern,FC_INDEX);
        FcPatternDel(pattern,FC_CHARSET);
        FcCharSetAddChar(charset,codepoint);
        FcPatternAddCharSet(pattern,FC_CHARSET,charset);
        FcCharSetDestroy(charset);
        double pixels=a->font_size;
        FcPatternGetDouble(base->pattern,FC_PIXEL_SIZE,0,&pixels);
        FcPatternDel(pattern,FC_SIZE);
        FcPatternDel(pattern,FC_PIXEL_SIZE);
        FcPatternAddDouble(pattern,FC_PIXEL_SIZE,pixels);
        if (base==a->bold_font && base!=a->font) {
            FcPatternDel(pattern,FC_WEIGHT);
            FcPatternAddInteger(pattern,FC_WEIGHT,FC_WEIGHT_BOLD);
        }
        FcResult result;
        FcPattern *match=XftFontMatch(a->dpy,DefaultScreen(a->dpy),pattern,&result);
        FcPatternDestroy(pattern);
        XftFont *font=match ? XftFontOpenPattern(a->dpy,match) : NULL;
        /* Xft owns the matched pattern only after a successful open. Fontconfig
           can return a best match even when no installed face has the glyph. */
        if (match && !font) FcPatternDestroy(match);
        if (font && !XftCharExists(a->dpy,font,codepoint)) {
            XftFontClose(a->dpy,font);
            font=NULL;
        }
        FontFallback *fallback=malloc(sizeof *fallback);
        if (!fallback) fatal("malloc");
        *fallback=(FontFallback){base,font,codepoint,a->fallbacks};
        a->fallbacks=fallback;
        return font ? font : base;
    }
    /* Both measuring and painting consume identical UTF-8 font runs. Invalid
       bytes still advance, so arbitrary executable names cannot stall redraw. */
    static int text_run(App *a, XftFont *base, const FcChar8 *s, int len,
                        XftFont **font) {
        bool ascii=base==a->font ? a->font_ascii :
                   base==a->bold_font && a->bold_ascii;
        int end=0;
        while (end<len) {
            int n=1;
            XftFont *next=base;
            /* Covered ASCII only needs a byte scan; defer decoding and glyph
               lookup to Unicode text or fonts with incomplete ASCII coverage. */
            if (!ascii || s[end]<0x20 || s[end]>0x7e) {
                FcChar32 codepoint;
                n=FcUtf8ToUcs4(s+end,&codepoint,len-end);
                if (n>0) next=font_for_char(a,base,codepoint);
                else n=1;
            }
            if (end && next!=*font) break;
            *font=next;
            end+=n;
        }
        return end;
    }
    static int text_width_n(App *a, const char *s, int len) {
        int width=0;
        for (int offset=0;offset<len;) {
            XftFont *font;
            int n=text_run(a,a->font,(const FcChar8*)s+offset,len-offset,&font);
            XGlyphInfo ext;
            XftTextExtentsUtf8(a->dpy,font,(const FcChar8*)s+offset,n,&ext);
            width+=ext.xOff;
            offset+=n;
        }
        return width;
    }
    static void draw_text_font(App *a, XftFont *font, int color, int x, int baseline,
                               const char *s, int max_width) {
        if (max_width<=0) return;
        int len=(int)strlen(s), origin=x;
        for (int offset=0;offset<len && x-origin<max_width;) {
            XftFont *run_font;
            int n=text_run(a,font,(const FcChar8*)s+offset,len-offset,&run_font);
            /* Keep one horizontal clip across runs, allowing taller fallback
               glyphs (including color emoji) to use their own vertical metrics. */
            int ascent=run_font->ascent>font->ascent ? run_font->ascent : font->ascent;
            int descent=run_font->descent>font->descent ? run_font->descent : font->descent;
            XRectangle clip={(short)origin,(short)(baseline-ascent),
                             (unsigned short)max_width,
                             (unsigned short)(ascent+descent+2)};
            XftDrawSetClipRectangles(a->draw,0,0,&clip,1);
            XftDrawStringUtf8(a->draw,&a->ink[color],run_font,x,baseline,
                              (const FcChar8*)s+offset,n);
            offset+=n;
            /* Only another run needs an advance. Single-font labels retain
               clipped drawing without a separate text measurement. */
            if (offset<len) {
                XGlyphInfo ext;
                XftTextExtentsUtf8(a->dpy,run_font,(const FcChar8*)s+offset-n,n,&ext);
                x+=ext.xOff;
            }
        }
    }
    static void draw_text(App *a, int color, int x, int baseline,
                          const char *s, int max_width) {
        draw_text_font(a,a->font,color,x,baseline,s,max_width);
    }
    static void paint(App *a) {
        refresh_hover(a);  /* Handles scrolling and async result updates. */
        const int w=a->width,h=a->height;
        rect(a,GC_BG,0,0,w,h);
        rect(a,GC_BORDER,0,0,w,1);
        rect(a,GC_BORDER,0,h-1,w,1);
        rect(a,GC_BORDER,0,0,1,h);
        rect(a,GC_BORDER,w-1,0,1,h);
        rect(a,GC_BORDER,0,a->header-1,w,1);
        const int legend_top=a->header+a->visible_rows*a->row_h;
        if (a->legend_rows) {
            /* The three-column shortcut legend is a dedicated footer band. */
            rect(a,GC_SELECT,1,legend_top,w-2,a->legend_h);
            rect(a,GC_BORDER,0,legend_top,w,1);
        }
        if (a->footer) rect(a,GC_BORDER,0,h-a->footer,w,1);
        for (int i=0;i<a->visible_rows && i+a->scroll<a->match_count;i++) {
            int index=i+a->scroll, y=a->header+i*a->row_h;
            bool selected=index==a->selected && (!a->hint_active || a->remembered_found);
            bool hovered=index==a->hovered_result;
            if (selected) {
                rect(a,GC_SELECT,8,y+2,w-16,a->row_h-3);
                rect(a,GC_ACCENT,8,y+2,3,a->row_h-3);
            }
            if (hovered) {
                if (!selected) {
                    rect(a,GC_ROW_HOVER,8,y+2,w-16,a->row_h-3);
                    rect(a,GC_ROW_HOVER_ACCENT,8,y+2,3,a->row_h-3);
                } else {
                    /* Both states visible: blue selection left, orange hover right. */
                    rect(a,GC_ROW_HOVER_ACCENT,w-11,y+2,3,a->row_h-3);
                }
            }
        }
        if (a->match_count>a->visible_rows) {
            /* Compact scrollbar proportional to the visible result window. */
            int top=a->header+3, track=a->visible_rows*a->row_h-6;
            int thumb=track*a->visible_rows/a->match_count;
            if (thumb<16) thumb=16;
            if (thumb>track) thumb=track;
            int position=(track-thumb)*a->scroll/(a->match_count-a->visible_rows);
            rect(a,GC_BORDER,w-8,top,3,track);
            rect(a,GC_ACCENT,w-8,top+position,3,thumb);
        }
        if (a->legend_rows) {
            for (size_t i=0;i<a->short_count;i++) {
                int x,y,bw,bh;
                shortcut_rect(a,i,&x,&y,&bw,&bh);
                rect(a,(int)i==a->hovered_short?GC_BUTTON_HOVER:GC_BUTTON,
                     x,y,bw,bh);
            }
        }
        /* The caret is drawn by XCB; only text needs Xft. */
        int input_x=79, input_limit=w-input_x-18;
        int start=0;
        const char *prompt=a->hint_active ? a->remembered.label : a->query;
        if (!prompt) prompt="";
        if (!a->hint_active) {
            while (start<a->cursor &&
                   text_width_n(a,a->query+start,a->cursor-start)>input_limit-5)
                start++;
            int cx=input_x+text_width_n(a,a->query+start,a->cursor-start);
            if (cx<=w-15) rect(a,GC_CURSOR,cx, (a->header-a->ascent-a->descent)/2,
                                2,a->ascent+a->descent);
        }
        /* XCB backgrounds must reach the server before Xft draws the text
           onto the same pixmap (both libraries share this connection). */
        xcb_flush(a->conn);

        int baseline=(a->header-a->ascent-a->descent)/2+a->ascent;
        draw_text(a,TEXT_GREEN,18,baseline,"run",50);
        draw_text(a,TEXT_MUTED,56,baseline,">",15);
        draw_text(a,a->hint_active?TEXT_MUTED:TEXT_MAIN,input_x,baseline,
                  prompt+start,input_limit);
        for (int i=0;i<a->visible_rows && i+a->scroll<a->match_count;i++) {
            int y=a->header+i*a->row_h;
            int row_base=y+(a->row_h-a->ascent-a->descent)/2+a->ascent;
            bool selected=i+a->scroll==a->selected &&
                          (!a->hint_active || a->remembered_found);
            bool hovered=i+a->scroll==a->hovered_result;
            draw_text(a,selected || hovered?TEXT_MAIN:TEXT_DIM,20,row_base,
                      a->entries[a->matches[i+a->scroll].entry].label,w-40);
        }
        if (!a->match_count) {
            int row_base=a->header+(a->row_h-a->ascent-a->descent)/2+a->ascent;
            draw_text(a,TEXT_MUTED,20,row_base,
                      a->scan_finished?"No matches":"Scanning PATH...",w-40);
        }
        if (a->legend_rows) {
            XftFont *bf=a->bold_font ? a->bold_font : a->font;
            for (size_t i=0;i<a->short_count;i++) {
                int x,y,bw,bh;
                shortcut_rect(a,i,&x,&y,&bw,&bh);
                int base=y+(bh-bf->ascent-bf->descent)/2+bf->ascent;
                int key_slot=50;
                draw_text_font(a,bf,TEXT_BLUE,x+12,base,a->shorts[i].key,key_slot-12);
                draw_text_font(a,bf,TEXT_MAIN,x+key_slot,base,
                               a->shorts[i].command,bw-key_slot-10);
            }
        }
        if (!a->no_count) {
            char footer[128];
            snprintf(footer,sizeof footer,"%zu entries%s",a->count,
                     a->scan_finished?"":"  /  scanning");
            draw_text(a,TEXT_MUTED,18,h-8,footer,w-36);
        }
        /* Flush Xft before presenting; direct mode has no blit. */
        XFlush(a->dpy);
        if (!a->no_double_buffering)
            xcb_copy_area(a->conn,a->back_pixmap,a->win,a->gc[GC_BG],
                          0,0,0,0,(uint16_t)w,(uint16_t)h);
        xcb_flush(a->conn);
    }
    /* Redraw only damaged surfaces. In default mode they are drawn to the
       persistent back pixmap and copied; with the opt-out, paint directly.
       Hover/navigation changes touch only affected rows/buttons. */
    static void row_background(App *a, int slot) {
        int y=a->header+slot*a->row_h;
        int index=a->scroll+slot;
        rect(a,GC_BG,8,y+2,a->width-16,a->row_h-3);
        if (index>=a->match_count) return;
        bool selected=index==a->selected &&
                      (!a->hint_active || a->remembered_found);
        bool hovered=index==a->hovered_result;
        if (selected) {
            rect(a,GC_SELECT,8,y+2,a->width-16,a->row_h-3);
            rect(a,GC_ACCENT,8,y+2,3,a->row_h-3);
        }
        if (hovered) {
            if (!selected) {
                rect(a,GC_ROW_HOVER,8,y+2,a->width-16,a->row_h-3);
                rect(a,GC_ROW_HOVER_ACCENT,8,y+2,3,a->row_h-3);
            } else rect(a,GC_ROW_HOVER_ACCENT,a->width-11,y+2,3,a->row_h-3);
        }
    }
    static void row_text(App *a, int slot) {
        int index=a->scroll+slot;
        if (index>=a->match_count) return;
        int y=a->header+slot*a->row_h;
        int base=y+(a->row_h-a->ascent-a->descent)/2+a->ascent;
        bool selected=index==a->selected &&
                      (!a->hint_active || a->remembered_found);
        bool hovered=index==a->hovered_result;
        draw_text(a,selected || hovered?TEXT_MAIN:TEXT_DIM,20,base,
                  a->entries[a->matches[index].entry].label,a->width-40);
    }
    static void button_background(App *a, int index) {
        if (index<0 || (size_t)index>=a->short_count) return;
        int x,y,w,h;
        shortcut_rect(a,(size_t)index,&x,&y,&w,&h);
        rect(a,index==a->hovered_short?GC_BUTTON_HOVER:GC_BUTTON,x,y,w,h);
    }
    static void button_text(App *a, int index) {
        if (index<0 || (size_t)index>=a->short_count) return;
        int x,y,w,h;
        shortcut_rect(a,(size_t)index,&x,&y,&w,&h);
        XftFont *font=a->bold_font ? a->bold_font : a->font;
        int base=y+(h-font->ascent-font->descent)/2+font->ascent;
        draw_text_font(a,font,TEXT_BLUE,x+12,base,a->shorts[index].key,38);
        draw_text_font(a,font,TEXT_MAIN,x+50,base,
                       a->shorts[index].command,w-60);
    }
    static void copy_region(App *a,int x,int y,int w,int h) {
        if (!a->no_double_buffering && w>0 && h>0)
            xcb_copy_area(a->conn,a->back_pixmap,a->win,a->gc[GC_BG],
                          (int16_t)x,(int16_t)y,(int16_t)x,(int16_t)y,
                          (uint16_t)w,(uint16_t)h);
    }
    static void present_pending(App *a) {
        if (!a->redraw_header && !a->redraw_results && !a->dirty_rows &&
            !a->button_hover_dirty && !a->redraw_count) return;
        const int w=a->width, h=a->height;
        const int rh=a->visible_rows*a->row_h;
        /* Scanning, re-ranking and scrolling change which result lies under
           a stationary pointer. Refresh before drawing new result rows. */
        if (a->redraw_results) refresh_hover(a);
        if (a->redraw_header) {
            rect(a,GC_BG,0,0,w,a->header);
            rect(a,GC_BORDER,0,0,w,1);
            rect(a,GC_BORDER,0,0,1,a->header);
            rect(a,GC_BORDER,w-1,0,1,a->header);
            rect(a,GC_BORDER,0,a->header-1,w,1);
            if (!a->hint_active) {
                int lim=w-79-18, start=0;
                while (start<a->cursor &&
                       text_width_n(a,a->query+start,a->cursor-start)>lim-5) start++;
                int cx=79+text_width_n(a,a->query+start,a->cursor-start);
                if (cx<=w-15)
                    rect(a,GC_CURSOR,cx,(a->header-a->ascent-a->descent)/2,
                         2,a->ascent+a->descent);
            }
        }
        if (a->redraw_results) {
            rect(a,GC_BG,0,a->header,w,rh);
            rect(a,GC_BORDER,0,a->header,1,rh);
            rect(a,GC_BORDER,w-1,a->header,1,rh);
            for (int i=0;i<a->visible_rows;i++) row_background(a,i);
            if (a->match_count>a->visible_rows) {
                int top=a->header+3,track=rh-6;
                int thumb=track*a->visible_rows/a->match_count;
                if (thumb<16) thumb=16;
                if (thumb>track) thumb=track;
                int pos=(track-thumb)*a->scroll/(a->match_count-a->visible_rows);
                rect(a,GC_BORDER,w-8,top,3,track);
                rect(a,GC_ACCENT,w-8,top+pos,3,thumb);
            }
        } else {
            for (int i=0;i<a->visible_rows;i++)
                if (a->dirty_rows & (1u<<i)) row_background(a,i);
        }
        int old_button=a->button_hover_dirty ? a->previous_hover_short:-1;
        int new_button=a->button_hover_dirty ? a->hovered_short:-1;
        if (old_button>=0) button_background(a,old_button);
        if (new_button>=0 && new_button!=old_button)
            button_background(a,new_button);
        if (a->redraw_count && a->footer) {
            rect(a,GC_BG,1,h-a->footer+1,w-2,a->footer-2);
        }
        /* Preserve XCB -> Xft draw order; no XSync or round trips. */
        xcb_flush(a->conn);
        if (a->redraw_header) {
            int lim=w-79-18, start=0;
            const char *prompt=a->hint_active ? a->remembered.label : a->query;
            if (!prompt) prompt="";
            if (!a->hint_active)
                while (start<a->cursor &&
                       text_width_n(a,a->query+start,a->cursor-start)>lim-5) start++;
            int base=(a->header-a->ascent-a->descent)/2+a->ascent;
            draw_text(a,TEXT_GREEN,18,base,"run",50);
            draw_text(a,TEXT_MUTED,56,base,">",15);
            draw_text(a,a->hint_active?TEXT_MUTED:TEXT_MAIN,79,base,prompt+start,lim);
        }
        if (a->redraw_results) {
            for (int i=0;i<a->visible_rows;i++) row_text(a,i);
            if (!a->match_count) {
                int base=a->header+(a->row_h-a->ascent-a->descent)/2+a->ascent;
                draw_text(a,TEXT_MUTED,20,base,
                          a->scan_finished?"No matches":"Scanning PATH...",w-40);
            }
        } else {
            for (int i=0;i<a->visible_rows;i++)
                if (a->dirty_rows & (1u<<i)) row_text(a,i);
        }
        if (old_button>=0) button_text(a,old_button);
        if (new_button>=0 && new_button!=old_button) button_text(a,new_button);
        if (a->redraw_count && a->footer) {
            char footer[128];
            snprintf(footer,sizeof(footer),"%zu entries%s",a->count,
                     a->scan_finished?"":"  /  scanning");
            draw_text(a,TEXT_MUTED,18,h-8,footer,w-36);
        }
        XFlush(a->dpy);
        if (a->redraw_header) copy_region(a,0,0,w,a->header);
        if (a->redraw_results) copy_region(a,0,a->header,w,rh);
        else for (int i=0;i<a->visible_rows;i++) {
            if (a->dirty_rows & (1u<<i))
                copy_region(a,8,a->header+i*a->row_h+2,w-16,a->row_h-3);
        }
        if (old_button>=0) {
            int x,y,bw,bh;
            shortcut_rect(a,(size_t)old_button,&x,&y,&bw,&bh);
            copy_region(a,x,y,bw,bh);
        }
        if (new_button>=0 && new_button!=old_button) {
            int x,y,bw,bh;
            shortcut_rect(a,(size_t)new_button,&x,&y,&bw,&bh);
            copy_region(a,x,y,bw,bh);
        }
        if (a->redraw_count && a->footer) copy_region(a,1,h-a->footer+1,w-2,a->footer-2);
        xcb_flush(a->conn);
        a->redraw_header=a->redraw_results=a->redraw_count=false;
        a->dirty_rows=0;
        a->button_hover_dirty=false;
    }
    static bool font_covers_ascii(XftFont *font) {
        FcChar32 map[FC_CHARSET_MAP_SIZE], next;
        if (FcCharSetFirstPage(font->charset,map,&next)!=0) return false;
        /* In Unicode page zero, printable ASCII (U+0020..U+007E) occupies
           words 1 and 2 and the low 31 bits of word 3. No glyphs are loaded. */
        return map[1]==UINT32_MAX && map[2]==UINT32_MAX &&
               (map[3]&0x7fffffffU)==0x7fffffffU;
    }
    static void init_xft(App *a) {
        int screen=DefaultScreen(a->dpy);
        a->font=XftFontOpenName(a->dpy,screen,a->font_pattern);
        if (!a->font) {
            fprintf(stderr,"pathpop: Xft cannot open font: %s\n",a->font_pattern);
            exit(1);
        }
        a->ascent=a->font->ascent;
        a->descent=a->font->descent;
        /* Use a separately matched bold face for the shortcut buttons. */
        char *bold_pattern=NULL;
        if (asprintf(&bold_pattern,"%s:weight=bold",a->font_pattern)<0) fatal("asprintf");
        a->bold_font=XftFontOpenName(a->dpy,screen,bold_pattern);
        free(bold_pattern);
        if (!a->bold_font) a->bold_font=a->font;
        a->font_ascii=font_covers_ascii(a->font);
        a->bold_ascii=a->bold_font==a->font ? a->font_ascii :
                      font_covers_ascii(a->bold_font);
        a->draw=XftDrawCreate(a->dpy,a->paint_target,DefaultVisual(a->dpy,screen),
                              DefaultColormap(a->dpy,screen));
        if (!a->draw) { fputs("pathpop: XftDrawCreate failed\n",stderr); exit(1); }
        init_color(a,TEXT_MAIN,0xf8f8f2);
        init_color(a,TEXT_DIM,0xa59f85);
        init_color(a,TEXT_MUTED,0x75715e);
        init_color(a,TEXT_GREEN,0xa6e22e);
        init_color(a,TEXT_BLUE,0x33b9f3);
    }
    static void keymap_load(App *a) {
        const xcb_setup_t *setup=xcb_get_setup(a->conn);
        a->mincode=setup->min_keycode;
        xcb_get_keyboard_mapping_cookie_t cookie=xcb_get_keyboard_mapping(
            a->conn,a->mincode,(uint8_t)(setup->max_keycode-a->mincode+1));
        free(a->keymap);
        a->keymap=xcb_get_keyboard_mapping_reply(a->conn,cookie,NULL);
    }
    static xcb_keysym_t keysym_for(App *a, const xcb_key_press_event_t *ev) {
        if (!a->keymap || ev->detail<a->mincode) return 0;
        int stride=a->keymap->keysyms_per_keycode;
        int total=xcb_get_keyboard_mapping_keysyms_length(a->keymap);
        int base=(ev->detail-a->mincode)*stride;
        if (stride<1 || base>=total) return 0;
        const xcb_keysym_t *syms=xcb_get_keyboard_mapping_keysyms(a->keymap);
        int shift=!!(ev->state & XCB_MOD_MASK_SHIFT);
        int altgr=!!(ev->state & XCB_MOD_MASK_5);
        int group=(altgr && stride>=3) ? 2 : 0;
        int col=group+(shift && stride>group+1);
        if (col>=stride || !syms[base+col]) col=group;
        if (col>=stride || !syms[base+col]) col=0;
        xcb_keysym_t k=syms[base+col];
        if ((ev->state & XCB_MOD_MASK_LOCK) && !altgr) {
            if (k>='a' && k<='z') k-=32;
            else if (k>='A' && k<='Z') k+=32;
        }
        return k;
    }
    static xcb_keysym_t parse_shortkey(const char *s) {
        if (s[0] && !s[1]) {
            unsigned char c=(unsigned char)s[0];
            if (isalnum(c)) return (xcb_keysym_t)c;
        }
        if ((s[0]=='F'||s[0]=='f') && isdigit((unsigned char)s[1])) {
            char *end; long n=strtol(s+1,&end,10);
            if (!*end && n>=1 && n<=35) return XK_F1+(xcb_keysym_t)(n-1);
        }
        if (!strcasecmp(s,"space")) return XK_space;
        if (!strcasecmp(s,"Tab")) return XK_Tab;
        return 0;
    }
    static void usage(FILE *out) {
        fprintf(out,
          "Usage: pathpop [OPTIONS]\n\n"
          "  -h, --help                 Show this help\n"
          "  ~/.config/pathpop          Optional startup options, one argument per line\n"
          "                             Config is loaded first; CLI options take precedence\n"
          "  --list                     Print candidate names without opening X11\n"
          "  --desktop                  Include and launch .desktop applications\n"
          "  --fuzz-char-swap           Match one adjacent-character transposition\n"
          "  --no-remember              Disable reading and writing last selection\n"
          "  --no-double-buffering      Draw directly to the window (disable back buffer)\n"
          "  --count                    Show entry count and its footer band\n"
          "  --font FONT                Xft/Fontconfig pattern, e.g. 'Consolas:pixelsize=16'\n"
          "                             Also accepts 'Consolas 16' for compatibility\n"
          "  --short KEY PROGRAM       Bind F1..F35 or case-sensitive A..Z/a..z/0..9\n"
          "                             Repeat --short; clickable buttons appear in 3 columns\n\n"
          "Config example (~/.config/pathpop):\n"
          "  --short\n  F1\n  thunar\n\n"
          "Example:\n"
          "  pathpop --font 'Consolas:pixelsize=16' --desktop\n"
          "    --short F1 thunar --short T thunar --short P pavucontrol\n\n"
          "Unmodified shortcut keys activate only when the typed prompt is empty.\n"
          "Enter re-launches the remembered item (grey prompt) or selection.\n"
          "Typing replaces the remembered prompt; Escape/Ctrl+C/right-click/focus loss closes.\n"
          "Hover highlights results; left-click launches; wheel scrolls results.\n"
          "Shortcut footer buttons are clickable.\n"
          "Ctrl+J/N (down), Ctrl+K/P (up); PageDown/PageUp: half-page.\n"
          "Ctrl+U clears the query; Ctrl+A/E/B/F/W/H edit input; Delete deletes next character.\n"
          "Commands run directly via execvp(), without a shell.\n");
    }
    static void set_font(App *a, const char *arg) {
        /* Xft/Fontconfig syntax is passed directly. Preserve the previous
           'Font Family 16' CLI style by translating a trailing pixel size. */
        free(a->font_pattern);
        if (strchr(arg,':')) {
            a->font_pattern=strdup(arg);
            /* We need only an approximate size to map the window immediately.
               The actual font metrics are initialized AFTER mapping. */
            const char *p=strstr(arg,"pixelsize=");
            if (p) {
                int n=atoi(p+10);
                if (n>=7 && n<=64) a->font_size=n;
            }
        } else {
            size_t len=strlen(arg),end=len,start=len;
            while (start && isspace((unsigned char)arg[start-1])) start--;
            end=start;
            while (start && isdigit((unsigned char)arg[start-1])) start--;
            int size=0;
            if (start<end && (start==0 || isspace((unsigned char)arg[start-1]))) {
                size=atoi(arg+start);
                if (size>=7 && size<=64) a->font_size=size;
                else size=0;
            }
            while (start && isspace((unsigned char)arg[start-1])) start--;
            if (size) {
                if (asprintf(&a->font_pattern,"%.*s:pixelsize=%d",(int)start,arg,a->font_size)<0)
                    fatal("asprintf");
            } else a->font_pattern=strdup(arg);
        }
        if (!a->font_pattern || !*a->font_pattern) {
            free(a->font_pattern);
            a->font_pattern=strdup("monospace:pixelsize=15");
        }
    }
    /* ~/.config/pathpop: one argument per line, not shell syntax.
       Blank lines and full-line # comments are ignored.  Parse config
       arguments BEFORE the real command line so explicit flags win. */
    typedef struct { char **args; size_t count, capacity; } ConfigArgs;
    static void free_config_args(ConfigArgs *c) {
        for (size_t i=0;i<c->count;i++) free(c->args[i]);
        free(c->args);
        *c=(ConfigArgs){0};
    }
    static void load_config_args(ConfigArgs *c) {
        const char *home=getenv("HOME");
        if (!home || home[0]!='/') return;
        char *path=NULL;
        if (asprintf(&path,"%s/.config/pathpop",home)<0) fatal("asprintf");
        FILE *f=fopen(path,"r");
        if (!f) {
            if (errno!=ENOENT) { perror(path); free(path); exit(2); }
            free(path);
            return;
        }
        char *line=NULL;
        size_t line_cap=0;
        ssize_t len;
        unsigned long line_no=0;
        while ((len=getline(&line,&line_cap,f))!=-1) {
            line_no++;
            /* Strip CR/LF and whitespace around the argument; leave inner
               spaces intact (e.g. a font pattern on a single line). */
            while (len>0 && (line[len-1]=='\n' || line[len-1]=='\r')) line[--len]=0;
            char *arg=line;
            while (*arg==' ' || *arg=='\t') arg++;
            size_t n=strlen(arg);
            while (n && (arg[n-1]==' ' || arg[n-1]=='\t')) arg[--n]=0;
            if (!*arg || *arg=='#') continue;
            if (c->count>=4096 || n>65536) {
                fprintf(stderr,"pathpop: %s:%lu: config limit exceeded\n",path,line_no);
                free(line); fclose(f); free(path); free_config_args(c); exit(2);
            }
            if (c->count==c->capacity) {
                size_t next=c->capacity ? c->capacity*2 : 16;
                char **args=realloc(c->args,next*sizeof(*args));
                if (!args) fatal("realloc");
                c->args=args; c->capacity=next;
            }
            c->args[c->count]=strdup(arg);
            if (!c->args[c->count]) fatal("strdup");
            c->count++;
        }
        if (ferror(f)) { perror(path); free(line); fclose(f); free(path); free_config_args(c); exit(2); }
        free(line);
        fclose(f);
        free(path);
    }
    static void parse_args(App *a, int argc, char **argv, bool *list) {
        a->font_size=15;
        a->font_pattern=strdup("monospace:pixelsize=15");
        for (int i=1;i<argc;i++) {
            const char *v=argv[i];
            if (!strcmp(v,"-h") || !strcmp(v,"--help")) { usage(stdout); exit(0); }
            if (!strcmp(v,"--list")) { *list=true; continue; }
            if (!strcmp(v,"--desktop")) { a->desktop_mode=true; continue; }
            if (!strcmp(v,"--fuzz-char-swap")) { a->fuzz_char_swap=true; continue; }
            if (!strcmp(v,"--no-remember")) { a->no_remember=true; continue; }
            if (!strcmp(v,"--no-double-buffering")) { a->no_double_buffering=true; continue; }
            if (!strcmp(v,"--count")) { a->no_count=false; continue; }
            if (!strcmp(v,"--font")) {
                if (++i>=argc) { fputs("pathpop: --font needs a value\n",stderr); exit(2); }
                set_font(a,argv[i]); continue;
            }
            if (!strcmp(v,"--short")) {
                if (i+2>=argc) { fputs("pathpop: --short needs KEY PROGRAM\n",stderr); exit(2); }
                const char *key=argv[++i];
                xcb_keysym_t sym=parse_shortkey(key);
                if (!sym) { fprintf(stderr,"pathpop: invalid shortcut key: %s\n",key); exit(2); }
                const char *cmd=argv[++i];
                if (!*cmd) { fputs("pathpop: empty shortcut program\n",stderr); exit(2); }
                Shortcut item={ .sym=sym, .key=strdup(key), .command=strdup(cmd) };
                if (!item.key || !item.command) fatal("strdup");
                /* Last definition wins, including CLI over config.  Preserve
                   its footer position rather than creating duplicate buttons. */
                bool replaced=false;
                for (size_t j=0;j<a->short_count;j++) {
                    if (a->shorts[j].sym!=sym) continue;
                    free(a->shorts[j].key);
                    free(a->shorts[j].command);
                    a->shorts[j]=item;
                    replaced=true;
                    break;
                }
                if (!replaced) {
                    Shortcut *s=realloc(a->shorts,(a->short_count+1)*sizeof(*s));
                    if (!s) fatal("realloc");
                    a->shorts=s;
                    a->shorts[a->short_count++]=item;
                }
                continue;
            }
            fprintf(stderr,"pathpop: unknown option: %s\n",v);
            usage(stderr); exit(2);
        }
    }

    static void parse_config_and_args(App *a, int argc, char **argv, bool *list) {
        ConfigArgs c={0};
        load_config_args(&c);
        if (!c.count) {
            parse_args(a,argc,argv,list);
            free_config_args(&c);
            return;
        }
        if (c.count>(size_t)(INT_MAX-argc)) {
            fputs("pathpop: too many config arguments\n",stderr);
            free_config_args(&c); exit(2);
        }
        int merged_argc=argc+(int)c.count;
        char **merged=calloc((size_t)merged_argc+1,sizeof(*merged));
        if (!merged) fatal("calloc");
        merged[0]=argv[0];
        for (size_t i=0;i<c.count;i++) merged[i+1]=c.args[i];
        for (int i=1;i<argc;i++) merged[c.count+(size_t)i]=argv[i];
        parse_args(a,merged_argc,merged,list);
        free(merged);
        free_config_args(&c);
    }

    /* A minimal desktop-entry reader: Name/Exec in [Desktop Entry], with hidden
       and non-Application files excluded. No locale/DBus activation support. */
    typedef struct { char *name, *exec; bool hidden, application; } Desktop;
    static void desktop_free(Desktop *d) { free(d->name); free(d->exec); }
    static Desktop desktop_read(const char *path) {
        Desktop d={0};
        FILE *f=fopen(path,"r"); if (!f) return d;
        char *line=NULL; size_t cap=0; bool in_section=false;
        while (getline(&line,&cap,f)>=0) {
            char *p=line;
            while (*p==' '||*p=='\t') p++;
            if (*p=='[') { in_section=!strncmp(p,"[Desktop Entry]",15); continue; }
            if (!in_section || *p=='#') continue;
            char *eq=strchr(p,'='); if (!eq) continue;
            *eq++=0;
            char *e=eq+strlen(eq);
            while (e>eq && (e[-1]=='\n'||e[-1]=='\r')) *--e=0;
            if (!strcmp(p,"Name") && !d.name) d.name=strdup(eq);
            else if (!strcmp(p,"Exec") && !d.exec) d.exec=strdup(eq);
            else if (!strcmp(p,"Type")) d.application=!strcmp(eq,"Application");
            else if (!strcmp(p,"Hidden") || !strcmp(p,"NoDisplay")) {
                if (!strcasecmp(eq,"true") || !strcmp(eq,"1")) d.hidden=true;
            }
        }
        free(line); fclose(f);
        return d;
    }
    /* Parse Exec without a shell: spaces, double quotes, backslash escapes and
       standard desktop field codes. We don't support filenames/URLs. */
    static char **desktop_argv(const char *s, const char *name, const char *path) {
        size_t cap=8, count=0;
        char **args=calloc(cap,sizeof(*args)); if (!args) return NULL;
        while (*s) {
            while (isspace((unsigned char)*s)) s++;
            if (!*s) break;
            char token[4096]; size_t n=0; bool quoted=false;
            while (*s && (quoted || !isspace((unsigned char)*s))) {
                if (*s=='"') { quoted=!quoted; s++; continue; }
                if (*s=='\\' && s[1]) { s++; if (n+1<sizeof(token)) token[n++]=*s; s++; continue; }
                if (*s=='%' && s[1]) {
                    char code=*++s; s++;
                    const char *sub=NULL;
                    if (code=='%') sub="%";
                    else if (code=='c') sub=name;
                    else if (code=='k') sub=path;
                    /* %f/%F/%u/%U need files/URLs; %i needs Icon. Drop them. */
                    if (sub) {
                        while (*sub && n+1<sizeof(token)) token[n++]=*sub++;
                    }
                    continue;
                }
                if (n+1<sizeof(token)) token[n++]=*s;
                s++;
            }
            if (!n) continue;
            token[n]=0;
            if (count+2>cap) {
                cap*=2; char **tmp=realloc(args,cap*sizeof(*args));
                if (!tmp) break;
                args=tmp;
            }
            args[count++]=strdup(token); args[count]=NULL;
        }
        return args;
    }
    static void launch_program(App *a, const Entry *entry, const char *override) {
        pid_t pid=fork();
        if (pid<0) { perror("fork"); return; }
        if (pid==0) {
            close(xcb_get_file_descriptor(a->conn));
            if (a->scan_fd>=0) close(a->scan_fd);
            setsid(); signal(SIGCHLD,SIG_DFL); signal(SIGPIPE,SIG_DFL);
            if (override) {
                char *const argv[]={ (char*)override,NULL };
                execvp(override,argv);
            } else if (entry && entry->desktop) {
                Desktop d=desktop_read(entry->path);
                if (d.application && !d.hidden && d.exec) {
                    char **argv=desktop_argv(d.exec,d.name ? d.name : entry->label,entry->path);
                    if (argv && argv[0]) execvp(argv[0],argv);
                }
            } else if (entry) {
                char *const argv[]={entry->label,NULL};
                execvp(entry->label,argv);
            }
            perror("pathpop: execvp"); _exit(127);
        }
        /* Persist only launches we attempted (not cancelled selections).
           A shortcut command also counts as the last launched program. */
        if (override) {
            Entry shortcut={ .label=(char*)override, .desktop=false };
            save_remembered(a,&shortcut);
        } else save_remembered(a,entry);
        /* _exit closes the shared Xlib/XCB connection and releases X grabs. */
        _exit(0);
    }
    static void on_key(App *a, const xcb_key_press_event_t *ev) {
        xcb_keysym_t k=keysym_for(a,ev);
        bool ctrl=!!(ev->state & XCB_MOD_MASK_CONTROL);
        bool alt=!!(ev->state & XCB_MOD_MASK_1);
        int letter=lower((int)k), changed=0;
        int before_selected=a->selected, before_scroll=a->scroll;
        int before_cursor=a->cursor;
        bool before_hint=a->hint_active;
        /* Ctrl+C aborts immediately, including during async scanning. */
        if (ctrl && letter=='c') _exit(0);
        /* The remembered grey hint is not typed input (qlen is zero).
           An actual query takes precedence over --short mappings. */
        if (!a->qlen && !ctrl && !alt &&
            !(ev->state & (XCB_MOD_MASK_4|XCB_MOD_MASK_5))) {
            for (size_t i=0;i<a->short_count;i++)
                if (k==a->shorts[i].sym) { launch_program(a,NULL,a->shorts[i].command); return; }
        }
        if (k==XK_Escape) _exit(0);
        if (k==XK_Return || k==XK_KP_Enter) {
            if (a->hint_active && a->remembered.label) {
                const Entry *e=a->remembered_found ?
                    &a->entries[a->matches[a->selected].entry] : &a->remembered;
                /* Works immediately, even before the async PATH scan finishes. */
                launch_program(a,e,NULL);
            } else if (a->match_count) {
                launch_program(a,&a->entries[a->matches[a->selected].entry],NULL);
            }
            return;
        }
        bool half_down=(k==XK_Next || k==XK_KP_Next);
        bool half_up=(k==XK_Prior || k==XK_KP_Prior);
        bool navigating=half_down || half_up || k==XK_Up || k==XK_Down ||
            (ctrl && (letter=='p' || letter=='k' || letter=='n' || letter=='j'));
        bool editing=k==XK_BackSpace || k==XK_Delete ||
            (ctrl && (letter=='u' || letter=='w' || letter=='h' ||
                      letter=='a' || letter=='e' || letter=='b' || letter=='f')) ||
            k==XK_Home || k==XK_End || k==XK_Left || k==XK_Right;
        bool inserting=!ctrl && !alt && k>=32 && k<=126;
        if (a->hint_active && (navigating || editing || inserting)) {
            /* Remembered text is a placeholder, not an editable query.
               First keystroke starts a fresh search rather than appending. */
            a->hint_active=false;
            a->remembered_found=false;
            if (!navigating) { a->selected=0; a->scroll=0; }
        }
        if (half_down || half_up) {
            half_page_move(a,half_down ? 1 : -1);
        } else if (k==XK_Up || (ctrl && (letter=='p' || letter=='k'))) {
            if (a->selected>0) a->selected--;
            keep_selection_visible(a);
        } else if (k==XK_Down || (ctrl && (letter=='n' || letter=='j'))) {
            if (a->selected+1<a->match_count) a->selected++;
            keep_selection_visible(a);
        } else if (ctrl && letter=='u') {
            /* Clear the whole query, regardless of cursor position. */
            changed=a->qlen>0;
            a->query[0]='\0';
            a->qlen=0;
            a->cursor=0;
        } else if (k==XK_Home || (ctrl && letter=='a')) a->cursor=0;
        else if (k==XK_End || (ctrl && letter=='e')) a->cursor=a->qlen;
        else if (k==XK_Left || (ctrl && letter=='b')) { if (a->cursor) a->cursor--; }
        else if (k==XK_Right || (ctrl && letter=='f')) { if (a->cursor<a->qlen) a->cursor++; }
        else if (ctrl && letter=='w') {
            int i=a->cursor;
            while (i && a->query[i-1]==' ') i--;
            while (i && a->query[i-1]!=' ') i--;
            changed=i<a->cursor;
            memmove(a->query+i,a->query+a->cursor,(size_t)(a->qlen-a->cursor+1));
            a->qlen-=a->cursor-i; a->cursor=i;
        } else if (k==XK_BackSpace || (ctrl && letter=='h')) {
            if (a->cursor) {
                memmove(a->query+a->cursor-1,a->query+a->cursor,(size_t)(a->qlen-a->cursor+1));
                a->cursor--; a->qlen--; changed=1;
            }
        } else if (k==XK_Delete) {
            if (a->cursor<a->qlen) {
                memmove(a->query+a->cursor,a->query+a->cursor+1,(size_t)(a->qlen-a->cursor));
                a->qlen--; changed=1;
            }
        } else if (!ctrl && !alt && k>=32 && k<=126 && a->qlen<MAX_QUERY) {
            memmove(a->query+a->cursor+1,a->query+a->cursor,(size_t)(a->qlen-a->cursor+1));
            a->query[a->cursor++]=(char)k; a->qlen++; changed=1;
        }
        if (changed) { a->selected=0; a->scroll=0; rank_matches(a); }
        if (changed || before_hint!=a->hint_active) {
            a->redraw_header=true;
            a->redraw_results=true;
        } else {
            if (before_cursor!=a->cursor) a->redraw_header=true;
            if (before_scroll!=a->scroll) a->redraw_results=true;
            else if (before_selected!=a->selected) {
                mark_row_damage(a,before_selected);
                mark_row_damage(a,a->selected);
            }
        }
    }
    static void on_scan_readable(App *a) {
        char data[16384]; bool changed=false;
        bool was_finished=a->scan_finished;
        for (;;) {
            ssize_t nr=read(a->scan_fd,data,sizeof(data));
            if (!nr) { close(a->scan_fd); a->scan_fd=-1; a->scan_finished=true; break; }
            if (nr<0) {
                if (errno==EINTR) continue;
                if (errno!=EAGAIN && errno!=EWOULDBLOCK) {
                    close(a->scan_fd); a->scan_fd=-1; a->scan_finished=true;
                }
                break;
            }
            for (ssize_t i=0;i<nr;i++) {
                char c=data[i];
                if (c=='\n') {
                    a->partial[a->partial_len]=0;
                    char *s=a->partial;
                    if (s[0]=='P' && s[1]=='\t') add_entry(a,s+2,NULL,false);
                    else if (s[0]=='D' && s[1]=='\t') {
                        char *tab=strchr(s+2,'\t');
                        if (tab) { *tab=0; add_entry(a,s+2,tab+1,true); }
                    }
                    a->partial_len=0; changed=true;
                } else if (a->partial_len+1<sizeof(a->partial)) {
                    a->partial[a->partial_len++]=c;
                }
            }
        }
        if (changed) rank_matches(a);
        if (changed || a->scan_finished!=was_finished) {
            a->redraw_results=true;
            if (!a->no_count) a->redraw_count=true;
        }
    }
    static int write_full(int fd, const char *s, size_t len) {
        while (len) {
            ssize_t n=write(fd,s,len);
            if (n>0) { s+=n; len-=(size_t)n; }
            else if (n<0 && errno==EINTR) continue;
            else return -1;
        }
        return 0;
    }
    static bool listing_mode;
    static int emit(int fd, char kind, const char *name, const char *path) {
        if (listing_mode) {
            if (write_full(fd,name,strlen(name))<0) return -1;
            return write_full(fd,"\n",1);
        }
        if (!*name || strchr(name,'\n') || strchr(name,'\t') ||
            (path && (strchr(path,'\n') || strchr(path,'\t')))) return 0;
        char line[MAX_LINE];
        int n=path ? snprintf(line,sizeof(line),"%c\t%s\t%s\n",kind,name,path)
                   : snprintf(line,sizeof(line),"%c\t%s\n",kind,name);
        if (n<0 || n>=(int)sizeof(line)) return 0;
        return write_full(fd,line,(size_t)n);
    }
    static char *join_path(const char *a, const char *b) {
        char *path=NULL;
        if (asprintf(&path,"%s/%s",a,b)<0) return NULL;
        return path;
    }
    static int scan_desktop_file(int fd, const char *path) {
        Desktop d=desktop_read(path);
        int rc=0;
        if (d.application && !d.hidden && d.name && d.exec)
            rc=emit(fd,'D',d.name,path);
        desktop_free(&d); return rc;
    }
    static int scan_path(int fd, bool desktop_mode) {
        const char *path=getenv("PATH"); if (!path) path="";
        for (const char *p=path;;) {
            const char *end=strchr(p,':');
            size_t len=end ? (size_t)(end-p) : strlen(p);
            char *dir=len ? strndup(p,len) : strdup(".");
            if (dir) {
                DIR *d=opendir(dir);
                if (d) {
                    int dfd=dirfd(d);
                    struct dirent *de;
                    while ((de=readdir(d))) {
                        const char *n=de->d_name;
                        if (!strcmp(n,".")||!strcmp(n,"..")) continue;
                        bool desktop=endswith(n,".desktop");
                        if (desktop && !desktop_mode) continue;
                        bool reg=de->d_type==DT_REG;
                        if (de->d_type==DT_LNK||de->d_type==DT_UNKNOWN) {
                            struct stat st;
                            reg=fstatat(dfd,n,&st,0)==0 && S_ISREG(st.st_mode);
                        }
                        if (!reg) continue;
                        if (desktop) {
                            char *full=join_path(dir,n);
                            if (full) { if (scan_desktop_file(fd,full)<0) {free(full);closedir(d);free(dir);return -1;} free(full); }
                        } else if (faccessat(dfd,n,X_OK,0)==0) {
                            if (emit(fd,'P',n,NULL)<0) { closedir(d);free(dir);return -1; }
                        }
                    }
                    closedir(d);
                }
                free(dir);
            }
            if (!end) break;
            p=end+1;
        }
        return 0;
    }
    static int scan_application_dir(int fd, const char *dir, int depth) {
        if (depth>2) return 0;
        DIR *d=opendir(dir); if (!d) return 0;
        struct dirent *de;
        while ((de=readdir(d))) {
            if (!strcmp(de->d_name,".")||!strcmp(de->d_name,"..")) continue;
            char *full=join_path(dir,de->d_name); if (!full) continue;
            struct stat st;
            if (stat(full,&st)==0) {
                if (S_ISDIR(st.st_mode) && depth<2) {
                    if (scan_application_dir(fd,full,depth+1)<0) {free(full);closedir(d);return -1;}
                } else if (S_ISREG(st.st_mode) && endswith(de->d_name,".desktop")) {
                    if (scan_desktop_file(fd,full)<0) {free(full);closedir(d);return -1;}
                }
            }
            free(full);
        }
        closedir(d); return 0;
    }
    static void scan_all(int fd, bool desktop_mode) {
        if (scan_path(fd,desktop_mode)<0 || !desktop_mode) return;
        const char *home=getenv("XDG_DATA_HOME");
        char *owned=NULL;
        if (!home || !*home) {
            const char *h=getenv("HOME");
            if (h && asprintf(&owned,"%s/.local/share",h)>=0) home=owned;
        }
        if (home) {
            char *apps=join_path(home,"applications");
            if (apps) { if (scan_application_dir(fd,apps,0)<0) {free(apps);free(owned);return;} free(apps); }
        }
        free(owned);
        const char *dirs=getenv("XDG_DATA_DIRS");
        if (!dirs || !*dirs) dirs="/usr/local/share:/usr/share";
        for (const char *p=dirs;;) {
            const char *end=strchr(p,':');
            size_t len=end ? (size_t)(end-p) : strlen(p);
            if (len) {
                char *dir=strndup(p,len);
                char *apps=dir ? join_path(dir,"applications") : NULL;
                free(dir);
                if (apps) { if (scan_application_dir(fd,apps,0)<0) {free(apps);return;} free(apps); }
            }
            if (!end) break;
            p=end+1;
        }
    }
    static void choose_monitor(xcb_connection_t *conn, xcb_screen_t *s,
                               int *x, int *y, int *w, int *h) {
        *x=0; *y=0; *w=s->width_in_pixels; *h=s->height_in_pixels;
    #ifndef HAVE_RANDR
        (void)conn;
    #endif
    #ifdef HAVE_RANDR
        xcb_query_pointer_cookie_t pc=xcb_query_pointer(conn,s->root);
        xcb_randr_get_monitors_cookie_t mc=xcb_randr_get_monitors(conn,s->root,1);
        xcb_query_pointer_reply_t *ptr=xcb_query_pointer_reply(conn,pc,NULL);
        int px=ptr ? ptr->root_x : *w/2, py=ptr ? ptr->root_y : *h/2;
        free(ptr);
        xcb_randr_get_monitors_reply_t *reply=xcb_randr_get_monitors_reply(conn,mc,NULL);
        if (reply) {
            xcb_randr_monitor_info_iterator_t it=xcb_randr_get_monitors_monitors_iterator(reply);
            for (;it.rem;xcb_randr_monitor_info_next(&it)) {
                xcb_randr_monitor_info_t *m=it.data;
                if (px>=m->x && py>=m->y && px<m->x+m->width && py<m->y+m->height) {
                    *x=m->x; *y=m->y; *w=m->width; *h=m->height;
                    break;
                }
            }
            free(reply);
        }
    #endif
    }
    int main(int argc, char **argv) {
        App a={ .scan_fd=-1, .width=WIDTH, .no_count=true,
                .hovered_short=-1, .hovered_result=-1,
                .pointer_x=-1, .pointer_y=-1 };
        bool list=false;
        parse_config_and_args(&a,argc,argv,&list);
        signal(SIGPIPE,SIG_IGN);
        if (list) { listing_mode=true; scan_all(STDOUT_FILENO,a.desktop_mode); return 0; }
        load_remembered(&a);

        /* Xlib owns the connection for Xft. XCB owns its event queue and
           performs window creation, monitor queries, grabs, and polling. */
        a.dpy=XOpenDisplay(NULL);
        if (!a.dpy) { fputs("pathpop: cannot connect to X11\n",stderr); return 1; }
        a.conn=XGetXCBConnection(a.dpy);
        if (!a.conn || xcb_connection_has_error(a.conn)) {
            fputs("pathpop: Xlib/XCB connection unavailable\n",stderr); return 1;
        }
        XSetEventQueueOwner(a.dpy,XCBOwnsEventQueue);
        int screen_number=DefaultScreen(a.dpy);
        xcb_screen_iterator_t si=xcb_setup_roots_iterator(xcb_get_setup(a.conn));
        for (int i=0;i<screen_number && si.rem;i++) xcb_screen_next(&si);
        if (!si.rem) { fputs("pathpop: invalid X11 screen\n",stderr); return 1; }
        xcb_screen_t *s=si.data;
        a.screen=s;
        a.row_h=(a.font_size*7/4>28) ? a.font_size*7/4 : 28;
        a.header=(a.font_size*16/5>50) ? a.font_size*16/5 : 50;
        a.footer=a.no_count ? 0 : ((a.font_size*9/5>25) ? a.font_size*9/5 : 25);
        a.visible_rows=ROWS;
        a.legend_row_h=LEGEND_BUTTON_HEIGHT;
        a.legend_rows=(int)((a.short_count+LEGEND_COLS-1)/LEGEND_COLS);
        a.legend_h=a.legend_rows ? 1+2*LEGEND_PAD_Y+
            a.legend_rows*a.legend_row_h+(a.legend_rows-1)*LEGEND_GAP_Y : 0;
        /* Without a legend or count footer, leave space below the last row.
           Otherwise result redraws can erase the bottom border and make
           the window appear cropped. */
        a.bottom_pad=(!a.legend_rows && !a.footer) ? 10 : 0;
        int mx,my,mw,mh;
        choose_monitor(a.conn,s,&mx,&my,&mw,&mh);
        a.width=a.width>mw ? mw : a.width;
        /* On short screens, keep the entire legend by showing fewer results. */
        while (a.visible_rows>1 &&
               a.header+a.visible_rows*a.row_h+a.legend_h+a.footer+a.bottom_pad>mh)
            a.visible_rows--;
        a.height=a.header+a.visible_rows*a.row_h+a.legend_h+a.footer+a.bottom_pad;
        if (a.height>mh && a.bottom_pad) {
            int excess=a.height-mh;
            a.bottom_pad-=excess<a.bottom_pad?excess:a.bottom_pad;
            a.height=a.header+a.visible_rows*a.row_h+a.legend_h+a.footer+a.bottom_pad;
        }
        if (a.height>mh) a.height=mh;
        a.x=mx+(mw-a.width)/2;
        a.y=my+(mh-a.height)/2;

        a.win=xcb_generate_id(a.conn);
        uint32_t mask=XCB_CW_BACK_PIXEL|XCB_CW_OVERRIDE_REDIRECT|XCB_CW_EVENT_MASK;
        uint32_t vals[]={ 0x272822,1,
            XCB_EVENT_MASK_EXPOSURE | XCB_EVENT_MASK_KEY_PRESS |
            XCB_EVENT_MASK_BUTTON_PRESS | XCB_EVENT_MASK_POINTER_MOTION |
            XCB_EVENT_MASK_ENTER_WINDOW | XCB_EVENT_MASK_LEAVE_WINDOW |
            XCB_EVENT_MASK_FOCUS_CHANGE | XCB_EVENT_MASK_STRUCTURE_NOTIFY };
        xcb_create_window(a.conn,XCB_COPY_FROM_PARENT,a.win,s->root,
            (int16_t)a.x,(int16_t)a.y,(uint16_t)a.width,(uint16_t)a.height,0,
            XCB_WINDOW_CLASS_INPUT_OUTPUT,s->root_visual,mask,vals);
        /* A persistent same-depth back buffer is used unless explicitly
           disabled. XCB and Xft must always share the chosen drawable. */
        a.paint_target=a.win;
        if (!a.no_double_buffering) {
            a.back_pixmap=xcb_generate_id(a.conn);
            xcb_create_pixmap(a.conn,s->root_depth,a.back_pixmap,a.win,
                              (uint16_t)a.width,(uint16_t)a.height);
            a.paint_target=a.back_pixmap;
        }
        make_gc(&a,GC_BG,0x272822);
        make_gc(&a,GC_BORDER,0x49483e);
        make_gc(&a,GC_SELECT,0x383830);
        make_gc(&a,GC_ACCENT,0x2790d9);
        make_gc(&a,GC_CURSOR,0xf8f8f2);
        make_gc(&a,GC_BUTTON,0x49483e);
        make_gc(&a,GC_BUTTON_HOVER,0x272822);
        make_gc(&a,GC_ROW_HOVER,0x49483e);
        make_gc(&a,GC_ROW_HOVER_ACCENT,0xfd971f);

        /* Show an immediately centered popup BEFORE Xft/Fontconfig resolution. */
        xcb_map_window(a.conn,a.win);
        xcb_set_input_focus(a.conn,XCB_INPUT_FOCUS_POINTER_ROOT,a.win,XCB_CURRENT_TIME);
        xcb_grab_keyboard(a.conn,0,a.win,XCB_CURRENT_TIME,
                          XCB_GRAB_MODE_ASYNC,XCB_GRAB_MODE_ASYNC);
        xcb_grab_pointer(a.conn,0,a.win,
            XCB_EVENT_MASK_BUTTON_PRESS | XCB_EVENT_MASK_POINTER_MOTION |
            XCB_EVENT_MASK_ENTER_WINDOW | XCB_EVENT_MASK_LEAVE_WINDOW,
            XCB_GRAB_MODE_ASYNC,XCB_GRAB_MODE_ASYNC,XCB_NONE,XCB_NONE,XCB_CURRENT_TIME);
        xcb_flush(a.conn);

        init_xft(&a);
        paint(&a);
        keymap_load(&a);

        int fds[2]; if (pipe2(fds,O_CLOEXEC)) fatal("pipe2");
        signal(SIGCHLD,SIG_IGN);
        pid_t scanner=fork(); if (scanner<0) fatal("fork");
        if (!scanner) {
            close(fds[0]); close(xcb_get_file_descriptor(a.conn));
            nice(10);
            scan_all(fds[1],a.desktop_mode);
            close(fds[1]); _exit(0);
        }
        close(fds[1]); a.scan_fd=fds[0];
        int flags=fcntl(a.scan_fd,F_GETFL);
        if (flags>=0) fcntl(a.scan_fd,F_SETFL,flags|O_NONBLOCK);

        for (;;) {
            xcb_generic_event_t *ev;
            while ((ev=xcb_poll_for_event(a.conn))) {
                int type=ev->response_type & 0x7f;
                if (type==XCB_KEY_PRESS) on_key(&a,(xcb_key_press_event_t*)ev);
                else if (type==XCB_EXPOSE) {
                    if (!((xcb_expose_event_t*)ev)->count) paint(&a);
                } else if (type==XCB_MAPPING_NOTIFY) keymap_load(&a);
                else if (type==XCB_FOCUS_OUT) {
                    /* Some X servers deliver an initial FocusOut even though the
                       window still owns focus. Check actual current focus. */
                    xcb_get_input_focus_reply_t *f=xcb_get_input_focus_reply(
                        a.conn,xcb_get_input_focus(a.conn),NULL);
                    bool lost=!f || f->focus!=a.win;
                    free(f);
                    if (lost) { free(ev); return 0; }
                } else if (type==XCB_MOTION_NOTIFY || type==XCB_ENTER_NOTIFY) {
                    xcb_motion_notify_event_t *m=(xcb_motion_notify_event_t*)ev;
                    set_pointer_hover(&a,m->event_x,m->event_y);
                } else if (type==XCB_LEAVE_NOTIFY) {
                    set_pointer_hover(&a,-1,-1);
                } else if (type==XCB_BUTTON_PRESS) {
                    xcb_button_press_event_t *b=(xcb_button_press_event_t*)ev;
                    int x=b->event_x, y=b->event_y;
                    a.pointer_x=x; a.pointer_y=y;
                    if (x<0 || x>=a.width || y<0 || y>=a.height || b->detail==3) {
                        free(ev); return 0;
                    }
                    if (b->detail==4 || b->detail==5) {
                        wheel_scroll(&a,b->detail==4 ? -1 : 1);
                    } else if (b->detail==1) {
                        int hit=shortcut_at(&a,x,y);
                        if (hit>=0) launch_program(&a,NULL,a.shorts[hit].command);
                        else if (y>=a.header && y<a.header+a.row_h*a.visible_rows) {
                            int row=a.scroll+(y-a.header)/a.row_h;
                            if (row<a.match_count) {
                                a.selected=row;
                                launch_program(&a,&a.entries[a.matches[row].entry],NULL);
                            }
                        }
                    }
                } else if (type==XCB_DESTROY_NOTIFY || type==XCB_UNMAP_NOTIFY) {
                    free(ev); return 0;
                }
                free(ev);
            }
            if (xcb_connection_has_error(a.conn)) return 1;
            /* Batch bursts of motion/keypress events into one presentation.
               Input is handled before paint and without a frame-rate timer. */
            present_pending(&a);
            struct pollfd pfds[2]; nfds_t n=1;
            pfds[0]=(struct pollfd){ .fd=xcb_get_file_descriptor(a.conn), .events=POLLIN };
            if (a.scan_fd>=0)
                pfds[n++]=(struct pollfd){ .fd=a.scan_fd,.events=POLLIN|POLLHUP };
            int rc=poll(pfds,n,-1);
            if (rc<0) { if (errno==EINTR) continue; return 1; }
            if (n==2 && pfds[1].revents) on_scan_readable(&a);
        }
    }
  meson.build: |
    project('pathpop', 'c', default_options: [
      'c_std=gnu11',
      'buildtype=release',
      'b_lto=true',
      'strip=true',
    ])

    xcb = dependency('xcb', required: true)
    randr = dependency('xcb-randr', required: true)
    x11 = dependency('x11', required: true)
    x11_xcb = dependency('x11-xcb', required: true)
    xft = dependency('xft', required: true)
    fontconfig = dependency('fontconfig', required: true)

    executable('pathpop', 'main.c',
      dependencies: [xcb, randr, x11, x11_xcb, xft, fontconfig],
      c_args: ['-O2', '-DHAVE_RANDR'],
      install: false,
    )
