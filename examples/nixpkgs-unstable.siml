#!/usr/bin/env hacman
# Cache the latest nixpkgs-unstable revision without modifying a host flake.
name: nixpkgs-unstable
url: https://channels.nixos.org/nixpkgs-unstable/git-revision
check: hash
schedule: 6h
install: |
  set -eu
  install -m644 "$HACMAN_RESPONSE" revision.next
  mv revision.next revision
