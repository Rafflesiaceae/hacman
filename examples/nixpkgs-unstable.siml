# A plain "did this URL change at all" watch: only the server's validators are
# compared, so nothing but headers is transferred.
name: nixpkgs-unstable
url: https://channels.nixos.org/nixpkgs-unstable/git-revision
check: etag
schedule: 6h
install: |
  set -eu
  echo "nixpkgs-unstable moved to $HACMAN_VERSION"
  nix flake update --flake "$HOME/workspace/nixcfg"
