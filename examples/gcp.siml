#!/usr/bin/env hacman
# Keep a private Google Cloud CLI current, then forward commands such as
# `./examples/gcp.siml projects list` to it.
name: google-cloud-cli
# Watch the x86_64 artifact as the release marker and select the local asset
# in the install block below.
url: https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz
check: etag
schedule: daily
bin-path: google-cloud-sdk/bin/gcloud
install: |
  set -eu

  # Recover the last good runtime if a previous replacement was interrupted.
  previous="$PWD/.gcp-previous"
  if [ ! -d "$PWD/google-cloud-sdk" ] && [ -d "$previous" ]; then
    mv "$previous" "$PWD/google-cloud-sdk"
  fi
  rm -rf "$previous"

  # Google publishes separate CLI archives for supported Linux architectures.
  case "$(uname -m)" in
    x86_64|amd64) release_arch=x86_64 ;;
    aarch64|arm64) release_arch=arm ;;
    *)
      echo "google-cloud-cli: unsupported Linux architecture: $(uname -m)" >&2
      exit 1
      ;;
  esac

  # Stage the complete self-contained runtime beside the active copy.
  stage="$(mktemp -d "$PWD/.gcp-update.XXXXXX")"
  trap 'rm -rf "$stage"' EXIT
  archive="google-cloud-cli-linux-$release_arch.tar.gz"
  curl -fsSL \
    "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/$archive" \
    -o "$stage/$archive"
  tar -xzf "$stage/$archive" -C "$stage"
  CLOUDSDK_CONFIG="$PWD/.gcloud-config" \
    "$stage/google-cloud-sdk/bin/gcloud" version >/dev/null

  # Rotate only after the downloaded runtime proves executable.
  if [ -d "$PWD/google-cloud-sdk" ]; then
    mv "$PWD/google-cloud-sdk" "$previous"
  fi
  if mv "$stage/google-cloud-sdk" "$PWD/google-cloud-sdk"; then
    rm -rf "$previous"
  else
    if [ -d "$previous" ]; then
      mv "$previous" "$PWD/google-cloud-sdk"
    fi
    exit 1
  fi
